+
+
+def top(entries, n):
+    """{'YYYY-MM': [entry, ...]} â€” the n most expensive entries of each month,
+    sorted expensive-to-cheap, ties broken by category."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    result = {}
+    for month in sorted(by_month):
+        items = sorted(by_month[month], key=lambda e: (-e["amount"], e["category"]))
+        result[month] = items[:n]
+    return result
