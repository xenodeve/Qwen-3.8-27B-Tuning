@@ -8,3 +8,17 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': up to n most expensive entries of that month}.
+
+    Within a month, entries are sorted by amount descending; ties are broken by
+    category ascending. Only months with at least one entry appear."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(by_month[month], key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month in sorted(by_month)
+    }
