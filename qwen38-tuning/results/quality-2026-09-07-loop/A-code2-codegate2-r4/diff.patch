+
+
+def test_parse_amount_handles_thousands_separators():
+    assert parse_line("2026-08-03 | rent | 12,000.00")["amount"] == 12000.0
+    assert parse_line("2026-08-15 | groceries | 1,250.00")["amount"] == 1250.0
+
+
+def test_parse_amount_rejects_garbage():
+    try:
+        parse_line("2026-08-03 | rent | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_with_commas():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    assert monthly_totals(entries) == {"2026-08": 13341.0}
+
+
+def test_top_returns_n_most_expensive_per_month():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+        parse_line("2026-09-02 | books | 890"),
+    ]
+    assert top(entries, 2) == {
+        "2026-08": [
+            {"date": "2026-08-03", "category": "rent", "amount": 12000.0},
+            {"date": "2026-08-15", "category": "groceries", "amount": 1250.0},
+        ],
+        "2026-09": [
+            {"date": "2026-09-01", "category": "rent", "amount": 12000.0},
+            {"date": "2026-09-02", "category": "books", "amount": 890.0},
+        ],
+    }
+
+
+def test_top_ties_break_by_category():
+    entries = [
+        parse_line("2026-08-03 | zebra | 100"),
+        parse_line("2026-08-04 | apple | 100"),
+        parse_line("2026-08-05 | mango | 100"),
+    ]
+    assert [e["category"] for e in top(entries, 2)["2026-08"]] == ["apple", "mango"]
+
+
+def test_top_n_larger_than_month_returns_all():
