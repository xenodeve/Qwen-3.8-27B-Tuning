     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [up to n most expensive entries]} for every month that has
+    at least one entry. Each month's list is sorted most-expensive first; ties
+    break by category (A->Z)."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(by_month[month], key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month in sorted(by_month)
+    }
