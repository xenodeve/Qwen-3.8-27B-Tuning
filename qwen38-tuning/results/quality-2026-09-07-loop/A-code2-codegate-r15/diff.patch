index b9e410e..ab42e38 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,17 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [up to n most expensive entries]} for each month.
+
+    Each month's list is sorted by amount, most expensive first; ties are
+    broken by category (alphabetical)."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(by_month[month], key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month in sorted(by_month)
+    }
