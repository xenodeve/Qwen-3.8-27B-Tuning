--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,16 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [top-n entries]} â€” the n most expensive entries per month,
+    sorted by amount descending, ties broken by category ascending."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    result = {}
+    for month in sorted(by_month):
+        ranked = sorted(by_month[month], key=lambda e: (-e["amount"], e["category"]))
+        result[month] = ranked[: max(0, n)]
+    return result
