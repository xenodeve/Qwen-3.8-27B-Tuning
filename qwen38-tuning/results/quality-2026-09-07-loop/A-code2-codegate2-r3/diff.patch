+def test_monthly_totals_sample_file():
+    totals = monthly_totals(load("data/sample.txt"))
+    assert totals["2026-08"] == 13341.0
+    assert totals["2026-09"] == 12890.0
+
+
+def test_top_orders_by_amount_desc_tie_by_category():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    result = top(entries, 3)
+    assert list(result) == ["2026-08"]
+    cats = [e["category"] for e in result["2026-08"]]
+    # rent (12000) first, groceries (1250) second, then the two 45.50 coffees
+    assert cats == ["rent", "groceries", "coffee"]
+
+
+def test_top_tie_broken_by_category_ascending():
+    entries = [
+        parse_line("2026-08-03 | zebra | 100"),
+        parse_line("2026-08-03 | apple | 100"),
+        parse_line("2026-08-03 | mango | 100"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["apple", "mango"]
+
+
+def test_top_limits_to_n_and_spans_months():
+    entries = [
