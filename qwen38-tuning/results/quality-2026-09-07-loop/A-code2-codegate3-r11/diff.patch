+def test_parse_amount_thousands_separator():
+    e = parse_line("2026-08-03 | rent | 12,000.00")
+    assert e["amount"] == 12000.0
+
+
+def test_parse_amount_unparseable_raises():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_sample():
+    entries = load("data/sample.txt")
+    assert monthly_totals(entries) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_top_picks_most_expensive():
+    entries = load("data/sample.txt")
+    t = top(entries, 2)
+    assert [e["category"] for e in t["2026-08"]] == ["rent", "groceries"]
+    assert [e["amount"] for e in t["2026-08"]] == [12000.0, 1250.0]
+    assert [e["category"] for e in t["2026-09"]] == ["rent", "books"]
+
+
+def test_top_tie_breaks_by_category():
+    entries = [
