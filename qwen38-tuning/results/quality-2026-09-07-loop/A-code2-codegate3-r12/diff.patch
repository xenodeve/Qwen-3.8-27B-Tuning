+
+def test_parse_amount_handles_thousands_commas():
+    assert parse_amount("1,250.00") == 1250.0
+    assert parse_amount("12,000.00") == 12000.0
+    assert parse_amount("45.50") == 45.5
+    assert parse_amount("12") == 12.0
+
+
+def test_parse_amount_rejects_garbage_instead_of_zero():
+    try:
+        parse_amount("abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_parse_line_rejects_bad_amount():
+    try:
+        parse_line("2026-08-03 | coffee | N/A")
+    except ValueError:
+        return
+    assert False
+
+
+def test_sample_totals():
+    totals = monthly_totals(load(SAMPLE))
+    assert totals["2026-08"] == 13341.0
+    assert totals["2026-09"] == 12890.0
+
+
+def test_top_returns_n_most_expensive_per_month():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+        parse_line("2026-09-02 | books | 890"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+    assert [e["category"] for e in result["2026-09"]] == ["rent", "books"]
+
+
+def test_top_ties_broken_by_category():
+    entries = [
+        parse_line("2026-08-03 | zebra | 100"),
+        parse_line("2026-08-04 | apple | 100"),
+        parse_line("2026-08-05 | mango | 100"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["apple", "mango"]
+
+
+def test_top_n_larger_than_month_size():
+    entries = [parse_line("2026-08-03 | coffee | 45.50")]
+    result = top(entries, 5)
+    assert len(result["2026-08"]) == 1
