@@ -8,3 +8,16 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [up to n most expensive entries]} for every month.
+
+    Each month's list is sorted expensive -> cheap; ties break by category (ascending)."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(items, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, items in sorted(by_month.items())
+    }
