+def test_parse_amount_rejects_garbage():
+    with pytest.raises(ValueError):
+        parse_line("2026-08-03 | coffee | forty-five")
+
+
+def test_parse_amount_rejects_empty():
+    with pytest.raises(ValueError):
+        parse_line("2026-08-03 | coffee | ")
+
+
+def test_top_largest_per_month_ties_by_category():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+        parse_line("2026-09-02 | books | 890"),
+    ]
+    t = top(entries, 2)
+    assert list(t) == ["2026-08", "2026-09"]
+    assert [(e["category"], e["amount"]) for e in t["2026-08"]] == [("rent", 12000.0), ("groceries", 1250.0)]
+    assert [(e["category"], e["amount"]) for e in t["2026-09"]] == [("rent", 12000.0), ("books", 890.0)]
+
