 def test_parse_line_basic():
@@ -23,3 +24,60 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_amount_strips_thousands_separators():
+    assert parse_amount("1,250.00") == 1250.0
+    assert parse_amount("12,000.00") == 12000.0
+    assert parse_amount("45.50") == 45.5
+    assert parse_amount("890") == 890.0
+
+
+def test_parse_amount_rejects_garbage():
+    try:
+        parse_amount("abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_parse_line_rejects_unparseable_amount():
+    try:
+        parse_line("2026-08-03 | coffee | not-a-number")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_sample():
+    totals = monthly_totals(load("data/sample.txt"))
+    assert totals["2026-08"] == 13341.0
+    assert totals["2026-09"] == 12890.0
+
+
+def test_top_returns_n_most_expensive_per_month():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+    assert [e["amount"] for e in result["2026-08"]] == [12000.0, 1250.0]
+
+
+def test_top_ties_broken_by_category():
+    entries = [
+        parse_line("2026-08-01 | zebra | 100"),
+        parse_line("2026-08-02 | apple | 100"),
+        parse_line("2026-08-03 | mango | 100"),
+    ]
+    result = top(entries, 3)
+    assert [e["category"] for e in result["2026-08"]] == ["apple", "mango", "zebra"]
+
+
+def test_top_n_larger_than_month_size():
+    entries = [parse_line("2026-08-01 | a | 5"), parse_line("2026-08-02 | b | 9")]
+    result = top(entries, 10)
+    assert [e["category"] for e in result["2026-08"]] == ["b", "a"]
