 def test_parse_line_basic():
@@ -23,3 +23,65 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_monthly_totals_handles_thousands_separators():
+    # 12,000.00 and 1,250.00 must be read as real amounts, not dropped to 0.0
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    assert monthly_totals(entries) == {"2026-08": 13341.0}
+
+
+def test_parse_amount_unparseable_raises():
+    # a genuinely unreadable amount must not be silently counted as zero
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_top_orders_most_expensive_first():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+
+
+def test_top_ties_broken_by_category():
+    entries = [
+        parse_line("2026-08-03 | zebra | 100"),
+        parse_line("2026-08-04 | apple | 100"),
+        parse_line("2026-08-05 | mango | 100"),
+    ]
+    result = top(entries, 3)
+    assert [e["category"] for e in result["2026-08"]] == ["apple", "mango", "zebra"]
+
+
+def test_top_limits_to_n():
+    entries = [
+        parse_line("2026-08-03 | a | 10"),
+        parse_line("2026-08-04 | b | 20"),
+        parse_line("2026-08-05 | c | 30"),
+    ]
+    result = top(entries, 1)
+    assert result["2026-08"] == [
+        {"date": "2026-08-05", "category": "c", "amount": 30.0}
+    ]
+
+
+def test_top_month_with_fewer_than_n_returns_all():
+    entries = [
+        parse_line("2026-08-03 | a | 10"),
+        parse_line("2026-09-01 | b | 20"),
+    ]
+    result = top(entries, 5)
+    assert len(result["2026-08"]) == 1
+    assert len(result["2026-09"]) == 1
