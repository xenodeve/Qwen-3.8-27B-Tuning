diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..19ab25e 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,52 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_total_after_add():
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 2)
+    s.add("apple", 1)
+    assert s.total() == 6
+
+
+def test_total_after_remove():
+    s = Store()
+    s.add("apple", 5)
+    s.add("pear", 2)
+    assert s.remove("apple", 3) == 2
+    assert s.total() == 4
+
+
+def test_total_tracks_negative_stock():
+    # remove() is allowed to drive a sku below zero; total() sums as-is.
+    s = Store()
+    s.add("apple", 2)
+    s.remove("apple", 5)
+    assert s.total() == -3
+
+
+def test_total_after_load(tmp_path):
+    p = tmp_path / "inv.json"
+    with open(p, "w", encoding="utf-8") as fh:
+        fh.write('{"apple": 3, "pear": -1}')
+    s = Store().load(p)
+    assert s.total() == 2
+
+
+def test_items_is_plain_dict():
+    s = Store()
+    assert type(s._items) is dict
+    s.add("apple", 1)
+    s.remove("apple", 1)
+    assert type(s._items) is dict
+
+
+def test_items_stays_plain_dict_after_load(tmp_path):
+    # load() reassigns _items; it must still be a plain dict afterwards.
+    p = tmp_path / "inv.json"
+    with open(p, "w", encoding="utf-8") as fh:
+        fh.write('{"apple": 3}')
+    s = Store().load(p)
+    assert type(s._items) is dict
