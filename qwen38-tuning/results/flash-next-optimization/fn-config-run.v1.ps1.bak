param(
  [Parameter(Mandatory=$true)][string]$RunId,
  [Parameter(Mandatory=$true)][string]$Ts,
  [Parameter(Mandatory=$true)][string]$NcMoE,
  [int]$Threads = 14,
  [int]$ThreadsBatch = 20,
  [string]$Probes = 'decode',
  [int]$DecodeRepeats = 2,
  [int]$Port = 8099,
  [string]$Note = ''
)

Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
. C:\AI\qwen38-tuning\results\flash-next-optimization\sv-lib.ps1

$probeDir = "$global:STUDY\prompts"

$proc = Start-FlashServer -NcMoE ([int]$NcMoE) -Ts $Ts -Threads $Threads -ThreadsBatch $ThreadsBatch -Port $Port -LogName ($RunId + '.log')
if (-not (Wait-Healthy -Port $Port)) {
  $gist = ''
  if (Test-Path $global:BOOTLOG) { $gist = (Get-Content $global:BOOTLOG -Tail 6 -ErrorAction SilentlyContinue) -join ' | ' }
  $g = Read-Vram
  Add-Result @{ run_id=$RunId; ctx=16384; b=2048; ub=512; ts=$Ts; nm=$NcMoE; t=$Threads; tb=$ThreadsBatch;
    pt=0; ot=0; ptps=0; dtps=0; ttft=0; wall=0; g0u=$g[0]; g0f=0; g1u=$g[1]; g1f=0; tot=($g[0]+$g[1]);
    u0=''; u1=''; rmu=0; rma=0; ws=0; pr=0; pg=0; ok='FAIL'; why='boot-failed'; note=$gist }
  Write-Log ("FAIL boot $RunId")
  Clear-Server
  exit 1
}
Write-Log ("healthy $RunId")


function Emit {
  param($r, [string]$ProbeName, [string]$Phase)
  $used = Read-Vram
  $u = Read-GpuUtil
  $t = Get-ProcTelemetry
  $ttft = 0
  if ($ProbeName -eq 'decode') { $ttft = $r.wall }
  $note = $Note + ' probe=' + $ProbeName + ' phase=' + $Phase
  if ($r.content -and $ProbeName -eq 'decode') {
    if ($r.content -match 'sum\(range\(1, ?11\)\)') { $note += ' answer=correct-sum' }
    elseif ([string]$r.content.Length -gt 0) { $note += ' answer=mismatch' }
  }
  Add-Result @{ run_id=$RunId; ctx=16384; b=2048; ub=512; ts=$Ts; nm=$NcMoE; t=$Threads; tb=$ThreadsBatch;
    pt=$r.prompt_tokens; ot=$r.out_tokens; ptps=[math]::Round($r.prompt_tps,2); dtps=[math]::Round($r.decode_tps,2);
    ttft=$ttft; wall=$r.wall; g0u=$used[0]; g0f=(12282-$used[0]); g1u=$used[1]; g1f=(16283-$used[1]); tot=($used[0]+$used[1]); u0=$u[0]; u1=$u[1];
    rmu=$t.ramUsedMb; rma=$t.ramAvailMb; ws=$t.wsMb; pr=$t.privMb; pg=$t.pgMb;
    ok= if ($r.ok) {'PASS'} else {'FAIL'}; why= if ($r.ok) {''} else {[string]$r.why}; note=$note }
  if ($r.ok) { Write-Log ("req ${RunId} ${ProbeName} ${Phase}: pt=$($r.prompt_tokens) ot=$($r.out_tokens) prefill=$([math]::Round($r.prompt_tps,2)) decode=$([math]::Round($r.decode_tps,2)) wall=$($r.wall)") }
  else { Write-Log ("req-fail ${RunId} ${ProbeName} ${Phase}: " + $r.why + ' raw=' + $r.raw) }
}

try {
  if ($Probes -match 'decode') {
    $decodeFile = Join-Path $probeDir 'decode512.json'
    for ($i = 1; $i -le $DecodeRepeats; $i++) {
      $r = Send-Request -PromptFile $decodeFile -Port $Port
      Emit $r 'decode' ("rep$i")
    }
  }

  if ($Probes -match 'all') {
    $files = @(@('pre4k', "$probeDir\pre4k.json"), @('pre16k', "$probeDir\pre16k.json"), @('pre32k', "$probeDir\pre32k.json"))
    foreach ($f in $files) {
      for ($i = 1; $i -le 3; $i++) {
        $r = Send-Request -PromptFile $f[1] -Port $Port
        Emit $r $f[0] ("rep$i")
      }
    }
  }
} catch {
  $msg = ('SCRIPT-ERROR ' + $RunId + ': ' + $_.ToString()).Replace([char]13, ' ').Replace([char]10, ' ')
  Write-Log $msg
  Write-Log ('SCRIPT-ERROR ' + $RunId + ' scriptstack: ' + ($_.ScriptStackTrace -replace [char]10, ' '))
}

Write-Manifest -RunId $RunId -Ts $Ts -NcMoE ([int]$NcMoE) -Threads $Threads -ThreadsBatch $ThreadsBatch
Clear-Server
Write-Log ("done $RunId")
