diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..8dd1905 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,29 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds what is in stock; the quantity is
+        left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} available"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold, fewest first.
+
+        Ties are broken by sku, ascending.
+        """
+        low = sorted((qty, sku) for sku, qty in self._items.items() if qty < threshold)
+        return [sku for qty, sku in low]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..0aa42c0 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,67 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_exactly_available_leaves_zero():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_more_than_available_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove accepted more than available"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError as e:
+        assert "ghost" in str(e)
+    else:
+        assert False, "remove accepted a missing sku"
+    assert s.quantity("ghost") == 0
+
+
+def test_low_stock_filters_and_orders():
+    s = Store()
+    s.add("banana", 1)
+    s.add("apple", 4)
+    s.add("cherry", 2)
+    s.add("date", 5)
+    # threshold 5: below are banana(1), cherry(2), apple(4)
+    assert s.low_stock(5) == ["banana", "cherry", "apple"]
+
+
+def test_low_stock_ties_broken_by_sku():
+    s = Store()
+    s.add("zeta", 2)
+    s.add("alpha", 2)
+    s.add("mid", 1)
+    assert s.low_stock(3) == ["mid", "alpha", "zeta"]
+
+
+def test_low_stock_empty_when_none_below():
+    s = Store()
+    s.add("apple", 5)
+    assert s.low_stock(5) == []
+    assert s.low_stock(0) == []
