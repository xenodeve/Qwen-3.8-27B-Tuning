@@ -20,6 +20,26 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    remaining = s.remove("apple", 2)
+    assert remaining == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_rejects_overdraw():
+    s = Store()
+    s.add("apple", 2)
+    for bad in (3, 100):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted overdraw of {bad!r}"
+    assert s.quantity("apple") == 2
+
+
