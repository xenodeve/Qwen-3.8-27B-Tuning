diff --git a/ledger/report.py b/ledger/report.py
index b9e410e..10553d6 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,19 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [the n most expensive entries of that month]} for every month.
+
+    Entries are ordered most expensive first; ties on amount are broken by
+    category (ascending). If fewer than n entries exist in a month, all of
+    them are returned. n <= 0 yields an empty list for each month."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    result = {}
+    for month in sorted(by_month):
+        ranked = sorted(by_month[month], key=lambda e: (-e["amount"], e["category"]))
+        result[month] = ranked[: max(n, 0)]
+    return result
