diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..06dafda 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -27,6 +27,13 @@ class Store:
         return self._items.get(sku, 0)
 
     def total(self):
+        # O(n) in the number of distinct SKUs. An O(1) total would need a running
+        # sum cached somewhere, but the only places it could live are both
+        # off-limits here: a new Store attribute is disallowed, and _items must
+        # stay a plain sku->qty dict (a sentinel key would break skus()/save()
+        # and load() rebuilds the dict, dropping it). The cache would also have
+        # to be maintained by add()/remove()/load(), which are not modifiable.
+        # So the sum is recomputed from _items on each call.
         return sum(self._items.values())
 
     def skus(self):
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..be654a6 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,37 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_items_is_plain_dict():
+    """The brief requires self._items to stay a plain dict (no subclass, no swap)."""
+    s = Store()
+    assert type(s._items) is dict
+    s.add("apple", 3)
+    s.remove("apple", 1)
+    assert type(s._items) is dict
+
+
+def test_items_is_plain_dict_after_load(tmp_path):
+    s = Store()
+    s.add("apple", 3)
+    p = tmp_path / "inv.json"
+    s.save(p)
+    t = Store().load(p)
+    assert type(t._items) is dict
+
+
+def test_total_after_remove():
+    s = Store()
+    s.add("apple", 5)
+    s.add("pear", 2)
+    s.remove("apple", 3)
+    assert s.quantity("apple") == 2
+    assert s.total() == 4
+
+
+def test_total_matches_sum_of_quantities():
+    s = Store()
+    for sku, qty in [("a", 1), ("b", 2), ("c", 3), ("a", 4)]:
+        s.add(sku, qty)
+    assert s.total() == sum(s.quantity(k) for k in s.skus())
