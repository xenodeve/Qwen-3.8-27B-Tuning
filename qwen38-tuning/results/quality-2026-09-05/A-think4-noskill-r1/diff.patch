diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..5a68cbf 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -1,3 +1,5 @@
+import json
+
 from inventory import Store
 
 
@@ -27,3 +29,67 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_total_after_remove():
+    s = Store()
+    s.add("apple", 5)
+    s.remove("apple", 2)
+    assert s.total() == 3
+
+
+def test_total_after_load(tmp_path):
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 4)
+    p = tmp_path / "inv.json"
+    s.save(p)
+    t = Store().load(p)
+    assert t.total() == 7
+
+
+def test_total_is_o1(monkeypatch):
+    s = Store()
+    for i in range(1000):
+        s.add(f"sku{i}", 1)
+    # Warm up: the first total() recomputes (O(n)) and caches the result.
+    assert s.total() == 1000
+
+    # Steady state: total() must be O(1), i.e. it must not sum the values.
+    calls = []
+    real_sum = sum
+
+    def counting_sum(*args, **kwargs):
+        calls.append(1)
+        return real_sum(*args, **kwargs)
+
+    monkeypatch.setattr("builtins.sum", counting_sum)
+    s.total()
+    s.total()
+    assert calls == []
+
+
+def test_items_is_plain_dict():
+    s = Store()
+    s.add("apple", 3)
+    s.total()
+    assert type(s._items) is dict
+
+
+def test_no_new_attributes():
+    s = Store()
+    s.add("apple", 3)
+    s.total()
+    assert set(s.__dict__.keys()) == {"_items"}
+
+
+def test_total_cache_hidden_from_skus_and_save(tmp_path):
+    s = Store()
+    s.add("apple", 3)
+    s.total()  # caches the total inside _items
+    assert s.skus() == ["apple"]
+    p = tmp_path / "inv.json"
+    s.save(p)
+    with open(p, encoding="utf-8") as fh:
+        data = json.load(fh)
+    assert data == {"apple": 3}
