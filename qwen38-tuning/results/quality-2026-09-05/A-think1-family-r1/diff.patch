diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..c7727b4 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,12 +16,18 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku.
+
+        Raises ValueError if qty exceeds the available quantity. Always
+        returns None; read the remaining quantity with quantity(sku).
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(f"cannot remove {qty} of {sku!r}; only {current} available")
         self._items[sku] = current - qty
-        return self._items[sku]
+        return None
 
     def quantity(self, sku):
         return self._items.get(sku, 0)
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..6141eb2 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,21 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_returns_none_and_updates_quantity():
+    s = Store()
+    s.add("apple", 5)
+    result = s.remove("apple", 2)
+    assert result is None
+    assert s.quantity("apple") == 3
+
+
+def test_remove_raises_when_exceeding_available():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError:
+        return
+    assert False, "remove accepted an over-removal"
