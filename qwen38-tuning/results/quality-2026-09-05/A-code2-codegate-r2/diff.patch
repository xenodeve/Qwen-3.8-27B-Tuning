+def test_parse_line_handles_thousands_separator():
+    e = parse_line("2026-08-03 | rent | 12,000.00")
+    assert e["amount"] == 12000.0
+
+
+def test_parse_line_rejects_unparseable_amount():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_sample_data():
+    entries = load("data/sample.txt")
+    assert monthly_totals(entries)["2026-08"] == 13341.0
+
+
+def test_top_returns_most_expensive_per_month():
+    entries = load("data/sample.txt")
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+    assert [e["amount"] for e in result["2026-08"]] == [12000.0, 1250.0]
+    assert [e["category"] for e in result["2026-09"]] == ["rent", "books"]
+
+
+def test_top_ties_broken_by_category():
+    entries = [
+        parse_line("2026-08-01 | zebra | 100"),
+        parse_line("2026-08-02 | apple | 100"),
+        parse_line("2026-08-03 | mango | 100"),
+    ]
+    result = top(entries, 2)
