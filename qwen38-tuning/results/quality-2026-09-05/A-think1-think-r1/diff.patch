+def test_remove_returns_none_and_reduces_quantity():
+    s = Store()
+    s.add("apple", 5)
+    result = s.remove("apple", 2)
+    assert result is None
+    assert s.quantity("apple") == 3
+
+
+def test_remove_more_than_available_raises():
+    s = Store()
+    s.add("apple", 2)
+    try:
+        s.remove("apple", 3)
+    except ValueError:
+        return
+    assert False, "remove accepted removing more than is in stock"
+
