@@ -8,3 +8,19 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': up to n most expensive entries} for each month.
+
+    Each month's list is sorted by amount, expensive first; ties break by
+    category, ascending. A month with fewer than n entries returns all of them.
+    """
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    result = {}
+    for month in sorted(by_month):
+        items = sorted(by_month[month], key=lambda e: (-e["amount"], e["category"]))
+        result[month] = items[:n]
+    return result
