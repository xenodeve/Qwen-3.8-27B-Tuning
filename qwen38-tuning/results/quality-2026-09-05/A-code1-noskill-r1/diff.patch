+def test_remove_happy_path():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_rejects_more_than_in_stock():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove accepted more than in stock"
+    # quantity must be unchanged after the failed remove
+    assert s.quantity("apple") == 3
+
+
+def test_remove_rejects_unknown_sku():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError as e:
+        assert "ghost" in str(e)
+    else:
+        assert False, "remove accepted unknown sku"
+    assert s.quantity("ghost") == 0
+
+
+def test_low_stock_filters_and_orders():
+    s = Store()
+    s.add("banana", 1)
+    s.add("apple", 2)
+    s.add("cherry", 2)
+    s.add("date", 10)
+    # below 3: banana(1), apple(2), cherry(2); date(10) excluded
+    assert s.low_stock(3) == ["banana", "apple", "cherry"]
+
+
+def test_low_stock_ties_broken_by_sku():
+    s = Store()
+    s.add("zeta", 1)
+    s.add("alpha", 1)
+    assert s.low_stock(5) == ["alpha", "zeta"]
+
+
+def test_low_stock_empty_when_none_below():
+    s = Store()
+    s.add("apple", 5)
+    assert s.low_stock(5) == []
+
+
