 """A tiny in-memory inventory. Quantities are whole units; a SKU is a non-empty string."""
 import json
 
+# Sentinel key total() uses to cache the running sum inside _items. Null bytes make it
+# an unrealistic SKU. The cached value is a (len, total) tuple so total() can tell in
+# O(1) whether the dict's key set changed since the sum was computed.
+_TOTAL = "\x00__total__\x00"
+
 
 class Store:
     def __init__(self):
@@ -27,14 +32,20 @@ class Store:
         return self._items.get(sku, 0)
 
     def total(self):
-        return sum(self._items.values())
+        d = self._items
+        cached = d.get(_TOTAL)
+        if isinstance(cached, tuple) and cached[0] == len(d):
+            return cached[1]
+        t = sum(v for k, v in d.items() if k != _TOTAL)
+        d[_TOTAL] = (len(d) + (0 if _TOTAL in d else 1), t)
+        return t
 
     def skus(self):
-        return sorted(self._items)
+        return sorted(k for k in self._items if k != _TOTAL)
 
     def save(self, path):
         with open(path, "w", encoding="utf-8") as fh:
-            json.dump(self._items, fh, sort_keys=True)
+            json.dump({k: v for k, v in self._items.items() if k != _TOTAL}, fh, sort_keys=True)
 
