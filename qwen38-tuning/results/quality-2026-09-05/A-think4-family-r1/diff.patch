diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..65efb8d 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -1,3 +1,5 @@
+import time
+
 from inventory import Store
 
 
@@ -27,3 +29,99 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+# --- constraints from the brief -------------------------------------------------
+
+def test_items_is_plain_dict():
+    s = Store()
+    s.add("apple", 3)
+    s.total()
+    assert type(s._items) is dict
+
+
+def test_no_new_instance_attributes():
+    s = Store()
+    s.add("apple", 3)
+    s.total()
+    # total() must not introduce a new attribute on the instance (e.g. self._total)
+    assert set(s.__dict__.keys()) == {"_items"}
+
+
+def test_add_remove_load_untouched():
+    import inspect
+    from inventory import store as mod
+    src = inspect.getsource(mod.Store)
+    # the three methods keep their original bodies (no cache logic smuggled in)
+    assert "self._items[sku] = self._items.get(sku, 0) + qty" in src
+    assert "self._items[sku] = current - qty" in src
+    assert "self._items = {str(k): int(v) for k, v in data.items()}" in src
+
+
+# --- correctness of the cached total -------------------------------------------
+
+def test_total_after_load(tmp_path):
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 2)
+    p = tmp_path / "inv.json"
+    s.save(p)
+    t = Store().load(p)
+    assert t.total() == 5
+
+
+def test_total_after_adding_new_sku():
+    s = Store()
+    s.add("apple", 3)
+    assert s.total() == 3
+    s.add("pear", 2)  # new SKU -> key set changes -> cache invalidated
+    assert s.total() == 5
+
+
+def test_total_repeated_calls_consistent():
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 2)
+    assert s.total() == 5
+    assert s.total() == 5
+    assert s.total() == 5
+
+
+def test_skus_and_save_hide_the_cache(tmp_path):
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 2)
+    s.total()  # populates the internal cache
+    assert s.skus() == ["apple", "pear"]
+    p = tmp_path / "inv.json"
+    s.save(p)
+    t = Store().load(p)
+    assert t.skus() == ["apple", "pear"]
+    assert t.total() == 5
+
+
+# --- O(1): repeated total() calls must not re-sum the dict ---------------------
+
+def test_total_is_o1_on_repeated_calls():
+    n = 50_000
+    s = Store()
+    build_start = time.perf_counter()
+    for i in range(n):
+        s.add(f"sku{i}", 1)
+    build_time = time.perf_counter() - build_start  # O(n) work, the baseline
+
+    s.total()  # warm up: first call computes the sum (O(n))
+
+    calls = 1000
+    t_start = time.perf_counter()
+    for _ in range(calls):
+        s.total()
+    total_time = time.perf_counter() - t_start
+
+    # If total() re-summed the n items on every call, `calls` calls would cost
+    # ~calls * n operations -- far more than building the store. An O(1) cached
+    # total makes `calls` calls far cheaper than the O(n) build.
+    assert total_time < build_time, (
+        f"{calls} total() calls took {total_time:.4f}s, not faster than the "
+        f"O(n) build ({build_time:.4f}s); total() is not O(1)"
+    )
