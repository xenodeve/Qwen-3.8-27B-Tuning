 import json
 
+# Reserved keys that let total() cache its answer inside the plain-dict _items
+# without adding a Store attribute. A NUL prefix makes them unusable as real SKUs.
+_TOTAL = "\x00__total__"
+_LEN = "\x00__len__"
+_RESERVED = (_TOTAL, _LEN)
+
 
 class Store:
     def __init__(self):
@@ -27,14 +33,25 @@ class Store:
