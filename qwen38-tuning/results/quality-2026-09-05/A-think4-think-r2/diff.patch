diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..1c476da 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -1,3 +1,6 @@
+import json
+import time
+
 from inventory import Store
 
 
@@ -27,3 +30,55 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_items_is_plain_dict():
+    # Constraint: _items must stay an exact dict (no subclass, no swap).
+    s = Store()
+    s.add("apple", 3)
+    s.total()  # populates the internal cache keys
+    assert type(s._items) is dict
+
+
+def test_total_is_o1():
+    # total() must not scale with store size: repeated calls on an unchanged
+    # store are O(1) reads of the cached total. An O(n) sum would make the
+    # large store ~100x slower than the small one.
+    def measure(n, calls=2000):
+        s = Store()
+        for i in range(n):
+            s.add(f"sku{i}", 1)
+        s.total()  # warmup: first compute
+        s.total()  # warmup: recompute once the cache keys land (len shifts)
+        start = time.perf_counter()
+        for _ in range(calls):
+            s.total()
+        return time.perf_counter() - start
+
+    t_small = measure(100)
+    t_large = measure(10000)
+    assert t_large < t_small * 5, (
+        f"total() scales with store size: small={t_small:.6f}s large={t_large:.6f}s"
+    )
+
+
+def test_total_after_load(tmp_path):
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 2)
+    p = tmp_path / "inv.json"
+    s.save(p)
+    t = Store().load(p)
+    assert t.total() == 5
+
+
+def test_cache_keys_do_not_leak(tmp_path):
+    s = Store()
+    s.add("apple", 3)
+    s.total()  # creates the internal cache keys
+    assert s.skus() == ["apple"]
+    p = tmp_path / "inv.json"
+    s.save(p)
+    with open(p, encoding="utf-8") as fh:
+        data = json.load(fh)
+    assert list(data) == ["apple"]
