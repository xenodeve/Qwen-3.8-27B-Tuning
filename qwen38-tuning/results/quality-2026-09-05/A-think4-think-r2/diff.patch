     def total(self):
-        return sum(self._items.values())
+        # O(1) in the steady state: return the cached total when the dict's
+        # length is unchanged since it was computed. len() is the only O(1)
+        # mutation signal available without touching add()/remove().
+        cached = self._items.get(_TOTAL)
+        cached_len = self._items.get(_LEN)
+        if cached is not None and cached_len == len(self._items):
+            return cached
+        total = sum(v for k, v in self._items.items() if k not in _RESERVED)
+        self._items[_TOTAL] = total
+        self._items[_LEN] = len(self._items)
+        return total
 
