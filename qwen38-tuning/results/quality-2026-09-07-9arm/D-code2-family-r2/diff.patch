 def test_parse_line_basic():
@@ -23,3 +23,52 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_line_thousands_separator():
+    e = parse_line("2026-08-03 | rent | 12,000.00")
+    assert e["amount"] == 12000.0
+
+
+def test_parse_line_unparseable_amount_raises():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_sample():
+    assert monthly_totals(load("data/sample.txt")) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_top_returns_month_to_entries_sorted_desc():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+    ]
+    assert top(entries, 2) == {
+        "2026-08": [
+            {"date": "2026-08-03", "category": "rent", "amount": 12000.0},
+            {"date": "2026-08-03", "category": "coffee", "amount": 45.5},
+        ],
+        "2026-09": [{"date": "2026-09-01", "category": "rent", "amount": 12000.0}],
+    }
+
+
+def test_top_tie_broken_by_category_ascending():
+    entries = [
+        parse_line("2026-08-01 | zeta | 100"),
+        parse_line("2026-08-02 | alpha | 100"),
+    ]
+    assert [e["category"] for e in top(entries, 2)["2026-08"]] == ["alpha", "zeta"]
+
+
+def test_top_n_larger_than_available():
+    entries = [parse_line("2026-08-01 | a | 1")]
+    assert top(entries, 5) == {"2026-08": [{"date": "2026-08-01", "category": "a", "amount": 1.0}]}
+
+
+def test_top_empty():
+    assert top([], 3) == {}
