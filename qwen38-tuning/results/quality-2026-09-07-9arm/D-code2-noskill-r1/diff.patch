--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,17 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [up to n entries]} for every month that has at least one
+    entry. Each month's list holds its most expensive entries, sorted by amount
+    descending, ties broken by category ascending."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    result = {}
+    for month in sorted(by_month):
+        ranked = sorted(by_month[month], key=lambda e: (-e["amount"], e["category"]))
+        result[month] = ranked[:n]
+    return result
