diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..49869d4 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,30 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity in stock; the
+        stored quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold, fewest first.
+
+        Ties in quantity are broken by sku name (ascending).
+        """
+        low = [(qty, sku) for sku, qty in self._items.items() if qty < threshold]
+        low.sort()
+        return [sku for qty, sku in low]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..f2dbcab 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,77 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_more_than_in_stock_raises_and_keeps_qty():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        raise AssertionError("remove more than in stock did not raise")
+    assert s.quantity("apple") == 3
+
+
+def test_remove_from_missing_sku_raises():
+    s = Store()
+    s.add("pear", 2)
+    try:
+        s.remove("apple", 1)
+    except ValueError as e:
+        assert "apple" in str(e)
+        assert "0" in str(e)
+    else:
+        raise AssertionError("remove from missing sku did not raise")
+    assert s.quantity("apple") == 0
+    assert "apple" not in s.skus()
+    assert s.quantity("pear") == 2
+
+
+def test_remove_exactly_in_stock_ok():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_sorts_by_qty_then_sku():
+    s = Store()
+    s.add("banana", 5)
+    s.add("apple", 2)
+    s.add("cherry", 2)
+    s.add("date", 1)
+    s.add("elder", 9)
+    assert s.low_stock(10) == ["date", "apple", "cherry", "banana", "elder"]
+    # apple and cherry tie at qty 2 -> ordered by sku
+    assert s.low_stock(3) == ["date", "apple", "cherry"]
+
+
+def test_low_stock_excludes_at_threshold():
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 3)
+    s.add("plum", 4)
+    assert s.low_stock(3) == []
+    assert s.low_stock(4) == ["apple", "pear"]
+    assert s.low_stock(5) == ["apple", "pear", "plum"]
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(10) == []
