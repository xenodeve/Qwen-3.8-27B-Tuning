diff --git a/ledger/report.py b/ledger/report.py
index b9e410e..40ab33f 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,23 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': the n most expensive entries of that month}.
+
+    Entries are ordered from most expensive to least; ties are ordered by
+    category (remaining ties keep input order). n must be a non-negative int;
+    n=0 gives [] for every month.
+    """
+    if not isinstance(n, int) or isinstance(n, bool):
+        raise TypeError(f"n must be an int, got {type(n).__name__}")
+    if n < 0:
+        raise ValueError(f"n must be >= 0, got {n}")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(months, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, months in sorted(by_month.items())
+    }
