diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..d6db18f 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,10 +16,16 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError when qty exceeds what is in stock; the stored
+        quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(f"cannot remove {qty} of {sku}: only {current} in stock")
         self._items[sku] = current - qty
         return self._items[sku]
 
@@ -32,6 +38,14 @@ class Store:
     def skus(self):
         return sorted(self._items)
 
+    def low_stock(self, threshold):
+        """Return skus with quantity strictly below threshold.
+
+        Ordered by quantity ascending, ties broken by sku.
+        """
+        ordered = sorted(self._items.items(), key=lambda item: (item[1], item[0]))
+        return [sku for sku, qty in ordered if qty < threshold]
+
     def save(self, path):
         with open(path, "w", encoding="utf-8") as fh:
             json.dump(self._items, fh, sort_keys=True)
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..9a643df 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,70 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_insufficient_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as exc:
+        msg = str(exc)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove accepted more than in stock"
+    assert s.quantity("apple") == 3
+    assert s.total() == 3
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    try:
+        s.remove("pear", 1)
+    except ValueError as exc:
+        assert "pear" in str(exc)
+    else:
+        assert False, "remove accepted qty for unknown sku"
+    assert s.quantity("pear") == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_exact_amount_ok():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_low_stock_filters_and_orders():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 1)
+    s.add("cherry", 1)
+    s.add("date", 5)
+    assert s.low_stock(3) == ["apple", "cherry", "banana"]
+
+
+def test_low_stock_excludes_equal_quantity():
+    s = Store()
+    s.add("apple", 2)
+    s.add("pear", 1)
+    assert s.low_stock(2) == ["pear"]
+    assert s.low_stock(1) == []
+
+
+def test_low_stock_empty_store():
+    s = Store()
+    assert s.low_stock(5) == []
