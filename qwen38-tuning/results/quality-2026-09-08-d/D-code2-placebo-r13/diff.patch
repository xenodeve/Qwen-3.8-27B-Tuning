index b9e410e..8951cb8 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,18 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': the n most expensive entries of that month}.
+
+    Entries are ordered most expensive first; ties are broken by category
+    (alphabetical). A month with fewer than n entries lists all of them."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    result = {}
+    for month in sorted(by_month):
+        ranked = sorted(by_month[month], key=lambda e: (-e["amount"], e["category"]))
+        result[month] = ranked[:n]
+    return result
