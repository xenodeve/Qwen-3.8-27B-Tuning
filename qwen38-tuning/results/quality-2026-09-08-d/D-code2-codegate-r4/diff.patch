@@ -23,3 +23,76 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_amount_handles_thousands_separators():
+    assert parse_line("2026-08-03 | rent | 12,000.00")["amount"] == 12000.0
+    assert parse_line("2026-08-15 | groceries | 1,250.00")["amount"] == 1250.0
+
+
+def test_monthly_totals_with_comma_amounts():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    assert monthly_totals(entries) == {"2026-08": 13341.0}
+
+
+def test_parse_amount_unparseable_raises():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_parse_amount_empty_raises():
+    try:
+        parse_line("2026-08-03 | coffee | ")
+    except ValueError:
+        return
+    assert False
+
+
+def test_load_missing_file_raises(tmp_path):
+    try:
+        load(tmp_path / "nope.txt")
+    except FileNotFoundError:
+        return
+    assert False
+
+
+def test_top_returns_n_most_expensive_per_month():
+    from ledger import top
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+    assert [e["category"] for e in result["2026-09"]] == ["rent"]
+
+
+def test_top_ties_sorted_by_category():
+    from ledger import top
+    entries = [
+        parse_line("2026-08-03 | zebra | 100"),
+        parse_line("2026-08-04 | apple | 100"),
+        parse_line("2026-08-05 | mango | 100"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["apple", "mango"]
+
+
+def test_top_negative_n_raises():
+    from ledger import top
+    entries = [parse_line("2026-08-03 | coffee | 45.50")]
+    try:
+        top(entries, -1)
+    except ValueError:
+        return
+    assert False
