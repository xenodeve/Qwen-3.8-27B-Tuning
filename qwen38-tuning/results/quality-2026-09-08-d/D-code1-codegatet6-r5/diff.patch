diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..6aa7d6a 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,16 +16,33 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty would take the stock below zero; the
+        stored quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is strictly below threshold.
+
+        Sorted by quantity ascending, ties broken by sku.
+        """
+        below = [(qty, sku) for sku, qty in self._items.items() if qty < threshold]
+        below.sort()
+        return [sku for _, sku in below]
+
     def total(self):
         return sum(self._items.values())
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..f90da47 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -1,3 +1,5 @@
+import pytest
+
 from inventory import Store
 
 
@@ -27,3 +29,77 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+# --- remove(): must not let stock go negative ------------------------------
+
+def test_remove_partial_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_exact_amount_ok():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_overdraw_raises_and_keeps_stock():
+    s = Store()
+    s.add("apple", 3)
+    with pytest.raises(ValueError) as exc:
+        s.remove("apple", 5)
+    # message names the sku and the quantity in stock
+    assert "apple" in str(exc.value)
+    assert "3" in str(exc.value)
+    # stock must be unchanged after the raise
+    assert s.quantity("apple") == 3
+
+
+def test_remove_from_missing_sku_raises():
+    s = Store()
+    with pytest.raises(ValueError):
+        s.remove("ghost", 1)
+    assert s.quantity("ghost") == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        with pytest.raises(ValueError):
+            s.remove("apple", bad)
+
+
+# --- low_stock(threshold): strictly below, sorted by qty then sku ----------
+
+def test_low_stock_strictly_below_sorted_by_qty_then_sku():
+    s = Store()
+    s.add("banana", 5)  # not below 3
+    s.add("apple", 1)
+    s.add("cherry", 1)  # tie with apple -> broken by sku
+    s.add("mango", 2)
+    s.add("date", 3)    # exactly threshold -> NOT below
+    assert s.low_stock(3) == ["apple", "cherry", "mango"]
+
+
+def test_low_stock_empty_when_none_below():
+    s = Store()
+    s.add("apple", 5)
+    assert s.low_stock(3) == []
+    assert s.low_stock(0) == []
+
+
+def test_low_stock_empty_store():
+    s = Store()
+    assert s.low_stock(5) == []
+
+
+def test_low_stock_all_below():
+    s = Store()
+    s.add("b", 2)
+    s.add("a", 1)
+    assert s.low_stock(10) == ["a", "b"]
