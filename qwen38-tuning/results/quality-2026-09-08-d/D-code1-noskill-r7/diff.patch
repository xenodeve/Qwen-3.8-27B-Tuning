diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..5665a6d 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -20,9 +20,17 @@ class Store:
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(f"cannot remove {qty} of {sku!r}: only {current} remaining")
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus with quantity below threshold, least first; ties by sku."""
+        low = [(sku, qty) for sku, qty in self._items.items() if qty < threshold]
+        low.sort(key=lambda kv: (kv[1], kv[0]))
+        return [sku for sku, qty in low]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..3c424bc 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,54 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_rejects_more_than_available():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as exc:
+        msg = str(exc)
+        # message must name the sku and the remaining quantity
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove accepted more than available"
+    # quantity must be unchanged after the failed removal
+    assert s.quantity("apple") == 3
+
+
+def test_remove_exact_amount_succeeds():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_unknown_sku_raises():
+    s = Store()
+    try:
+        s.remove("mystery", 1)
+    except ValueError as exc:
+        assert "mystery" in str(exc)
+    else:
+        assert False, "remove accepted a sku that was never added"
+    assert s.quantity("mystery") == 0
+
+
+def test_low_stock_filters_and_orders():
+    s = Store()
+    s.add("banana", 1)
+    s.add("apple", 2)
+    s.add("cherry", 2)
+    s.add("date", 4)
+    # only quantities strictly below 3 qualify
+    assert s.low_stock(3) == ["banana", "apple", "cherry"]
+    # ties on quantity are ordered by sku
+    assert s.low_stock(5) == ["banana", "apple", "cherry", "date"]
+    assert s.low_stock(0) == []
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(10) == []
