+
+
+def test_parse_amount_thousands_separator():
+    assert parse_amount("1,250.00") == 1250.0
+    assert parse_amount("12,000.00") == 12000.0
+    assert parse_amount("12345") == 12345.0
+
+
+def test_parse_amount_unreadable_raises():
+    for bad in ("abc", "12.34.56", "1,2,3"):
+        try:
+            parse_amount(bad)
+        except ValueError:
+            pass
+        else:
+            assert False, f"{bad!r} should raise"
+
+
+def test_parse_line_unreadable_amount_raises():
+    try:
+        parse_line("2026-08-03 | coffee | N/A")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_with_separators():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    assert monthly_totals(entries) == {"2026-08": 13341.0}
+
+
+def test_sample_file_august_total():
