+
+
+def test_top_orders_expensive_first_with_category_tiebreak():
+    entries = [
+        parse_line("2026-08-01 | b | 100"),
+        parse_line("2026-08-02 | a | 100"),
+        parse_line("2026-08-03 | z | 50"),
+        parse_line("2026-09-01 | m | 7"),
+    ]
+    assert top(entries, 2) == {
