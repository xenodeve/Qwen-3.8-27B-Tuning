 """Expense lines: `YYYY-MM-DD | category | amount`. Amounts are written the way people
 write them: `45.50`, `1,250.00`, `12`. Blank lines and lines starting with # are skipped."""
+import re
+
+# the documented formats: optional sign, then either a plain integer or
+# comma-grouped thousands (1-3 digits after each comma), then an optional
+# decimal part. Anything else is a bad line, not a zero expense.
+_AMOUNT = re.compile(r"^[+-]?(?:\d{1,3}(?:,\d{3})*|\d+)(?:\.\d+)?$")
 
 
 def parse_amount(text):
     text = text.strip()
-    try:
-        return float(text)
-    except ValueError:
-        # unparseable amount: keep the line, count it as nothing
-        return 0.0
+    if not _AMOUNT.match(text):
+        # an unreadable amount is not a zero expense: raise so the bad line
+        # cannot silently corrupt the totals
+        raise ValueError(f"bad amount {text!r}")
+    return float(text.replace(",", ""))
 
 
 def parse_line(line):
