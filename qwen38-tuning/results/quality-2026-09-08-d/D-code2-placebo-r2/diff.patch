index b9e410e..eb16c64 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,17 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': the n most expensive entries of that month}.
+
+    Each month's list is sorted by amount, most expensive first; equal
+    amounts break ties by category (alphabetical)."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(items, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, items in sorted(by_month.items())
+    }
