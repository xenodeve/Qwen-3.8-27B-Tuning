 def test_parse_line_basic():
@@ -23,3 +23,91 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_line_comma_amount():
+    e = parse_line("2026-08-03 | rent | 12,000.00")
+    assert e == {"date": "2026-08-03", "category": "rent", "amount": 12000.0}
+
+
+def test_monthly_totals_comma_amounts(tmp_path):
+    p = tmp_path / "l.txt"
+    p.write_text(
+        "2026-08-03 | coffee | 45.50\n"
+        "2026-08-03 | rent | 12,000.00\n"
+        "2026-08-15 | groceries | 1,250.00\n"
+        "2026-08-20 | coffee | 45.50\n",
+        encoding="utf-8",
+    )
+    assert monthly_totals(load(p)) == {"2026-08": 13341.0}
+
+
+def test_sample_file_totals():
+    assert monthly_totals(load("data/sample.txt")) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_parse_line_rejects_unparseable_amount():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_parse_line_rejects_non_finite_amount():
+    try:
+        parse_line("2026-08-03 | coffee | nan")
+    except ValueError:
+        return
+    assert False
+
+
+def test_top_returns_most_expensive_per_month():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+        parse_line("2026-09-02 | books | 890"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+    assert [e["category"] for e in result["2026-09"]] == ["rent", "books"]
+
+
+def test_top_orders_ties_by_category():
+    entries = [
+        parse_line("2026-08-03 | zebra | 100"),
+        parse_line("2026-08-04 | apple | 100"),
+    ]
+    assert [e["category"] for e in top(entries, 2)["2026-08"]] == ["apple", "zebra"]
+
+
+def test_top_returns_full_entries():
+    e = parse_line("2026-08-03 | coffee | 45.50")
+    assert top([e], 1) == {"2026-08": [e]}
+
+
+def test_top_n_larger_than_month_returns_all():
+    entries = [parse_line("2026-08-03 | coffee | 45.50")]
+    assert len(top(entries, 5)["2026-08"]) == 1
+
+
+def test_top_empty_entries():
+    assert top([], 3) == {}
+
+
+def test_top_rejects_negative_n():
+    try:
+        top([], -1)
+    except ValueError:
+        return
+    assert False
+
+
+def test_top_rejects_non_int_n():
+    try:
+        top([], "2")
+    except TypeError:
+        return
+    assert False
