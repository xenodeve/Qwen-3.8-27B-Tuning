diff --git a/ledger/report.py b/ledger/report.py
index b9e410e..8e13fbf 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,23 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': the n most expensive entries of that month}.
+
+    Each month's list is ordered from most expensive to least; entries with
+    equal amounts are ordered by category. `n` must be a non-negative int.
+    """
+    if not isinstance(n, int) or isinstance(n, bool):
+        raise TypeError(f"n must be an int, got {type(n).__name__}")
+    if n < 0:
+        raise ValueError(f"n must be >= 0, got {n}")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    # amount descending, then category ascending as the tie-break
+    return {
+        month: sorted(items, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, items in sorted(by_month.items())
+    }
diff --git a/tests/test_ledger.py b/tests/test_ledger.py
