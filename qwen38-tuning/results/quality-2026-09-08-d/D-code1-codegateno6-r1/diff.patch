--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -20,6 +20,53 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_raises_when_exceeding_stock():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove accepted qty beyond stock"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    try:
+        s.remove("pear", 1)
+    except ValueError as e:
+        assert "pear" in str(e)
+    else:
+        assert False, "remove accepted qty for unknown sku"
+    assert s.quantity("pear") == 0
+
+
+def test_remove_exact_stock_ok():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_low_stock():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 5)
+    s.add("cherry", 1)
+    s.add("date", 1)
+    s.add("fig", 10)
+    # below 5 only: cherry(1), date(1) tie -> sku order, then banana(2)
+    assert s.low_stock(5) == ["cherry", "date", "banana"]
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(5) == []
+
+
