diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..03c0172 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,30 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity in stock; the stored
+        quantity is left unchanged when it raises.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold.
+
+        Sorted by quantity ascending; ties are broken by sku ascending.
+        """
+        below = [(qty, sku) for sku, qty in self._items.items() if qty < threshold]
+        below.sort()
+        return [sku for _, sku in below]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..3f772b9 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -1,3 +1,5 @@
+import pytest
+
 from inventory import Store
 
 
@@ -27,3 +29,88 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+# --- remove() ---
+
+def test_remove_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_exactly_in_stock_leaves_zero():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_more_than_in_stock_raises_and_keeps_qty():
+    s = Store()
+    s.add("apple", 3)
+    with pytest.raises(ValueError) as exc:
+        s.remove("apple", 5)
+    # quantity must be unchanged after the raise
+    assert s.quantity("apple") == 3
+    # message must name the sku and the remaining quantity
+    msg = str(exc.value)
+    assert "apple" in msg
+    assert "3" in msg
+
+
+def test_remove_from_missing_sku_raises():
+    s = Store()
+    with pytest.raises(ValueError):
+        s.remove("ghost", 1)
+    assert s.quantity("ghost") == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        with pytest.raises(ValueError):
+            s.remove("apple", bad)
+    assert s.quantity("apple") == 3
+
+
+# --- low_stock() ---
+
+def test_low_stock_returns_skus_below_threshold_sorted_by_qty():
+    s = Store()
+    s.add("apple", 1)
+    s.add("pear", 4)
+    s.add("plum", 2)
+    s.add("kiwi", 10)
+    # threshold 5: apple(1), plum(2), pear(4) are below; kiwi(10) is not
+    assert s.low_stock(5) == ["apple", "plum", "pear"]
+
+
+def test_low_stock_tie_broken_by_sku():
+    s = Store()
+    s.add("pear", 2)
+    s.add("apple", 2)
+    s.add("plum", 2)
+    assert s.low_stock(5) == ["apple", "pear", "plum"]
+
+
+def test_low_stock_excludes_equal_to_threshold():
+    s = Store()
+    s.add("apple", 5)
+    s.add("pear", 4)
+    # strictly less than 5: only pear
+    assert s.low_stock(5) == ["pear"]
+
+
+def test_low_stock_empty_store_returns_empty():
+    s = Store()
+    assert s.low_stock(5) == []
+
+
+def test_low_stock_none_below_threshold_returns_empty():
+    s = Store()
+    s.add("apple", 5)
+    s.add("pear", 6)
+    assert s.low_stock(5) == []
