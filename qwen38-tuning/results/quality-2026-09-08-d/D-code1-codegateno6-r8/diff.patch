diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..bd87d66 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,16 +16,36 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError when qty would take the quantity below zero;
+        the stored quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} left"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
+    def low_stock(self, threshold):
+        """Return skus with quantity strictly below threshold, fewest first.
+
+        Skus with equal quantities are ordered by sku. A threshold no
+        sku can be below (e.g. 0) yields an empty list.
+        """
+        return [
+            sku
+            for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+            if qty < threshold
+        ]
+
     def total(self):
         return sum(self._items.values())
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..b4a3628 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -1,3 +1,5 @@
+import pytest
+
 from inventory import Store
 
 
@@ -20,6 +22,62 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_exact_available():
+    s = Store()
+    s.add("pear", 2)
+    assert s.remove("pear", 2) == 0
+    assert s.quantity("pear") == 0
+
+
+def test_remove_more_than_available_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    with pytest.raises(ValueError) as excinfo:
+        s.remove("apple", 5)
+    message = str(excinfo.value)
+    assert "apple" in message
+    assert "3" in message
+    assert s.quantity("apple") == 3
+    assert s.total() == 3
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    with pytest.raises(ValueError) as excinfo:
+        s.remove("ghost", 1)
+    assert "ghost" in str(excinfo.value)
+    assert s.quantity("ghost") == 0
+    assert s.total() == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_orders_by_quantity_then_sku():
+    s = Store()
+    s.add("banana", 5)
+    s.add("apple", 1)
+    s.add("cherry", 1)
+    s.add("date", 3)
+    assert s.low_stock(4) == ["apple", "cherry", "date"]
+    assert s.low_stock(10) == ["apple", "cherry", "date", "banana"]
+    assert s.low_stock(1) == []
+    assert s.low_stock(0) == []
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(5) == []
+
+
