diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..9a179cc 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -20,9 +20,18 @@ class Store:
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus with quantity below threshold, ordered by quantity then sku."""
+        low = sorted((qty, sku) for sku, qty in self._items.items() if qty < threshold)
+        return [sku for _, sku in low]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..5c51f11 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,60 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_overdraw_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 4)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove did not raise"
+    assert s.quantity("apple") == 3
+    assert s.total() == 3
+
+
+def test_remove_more_than_zero_stock_raises():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError as e:
+        assert "ghost" in str(e)
+        assert "0" in str(e)
+    else:
+        assert False, "remove did not raise"
+    assert s.quantity("ghost") == 0
+
+
+def test_remove_exact_stock_is_allowed():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_low_stock_filters_and_orders():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 1)
+    s.add("cherry", 5)
+    s.add("date", 1)
+    assert s.low_stock(3) == ["apple", "date", "banana"]
+
+
+def test_low_stock_excludes_equal_to_threshold():
+    s = Store()
+    s.add("apple", 3)
+    s.add("banana", 2)
+    assert s.low_stock(3) == ["banana"]
+
+
+def test_low_stock_empty_when_none_below():
+    s = Store()
+    s.add("apple", 3)
+    assert s.low_stock(3) == []
+    assert Store().low_stock(1) == []
