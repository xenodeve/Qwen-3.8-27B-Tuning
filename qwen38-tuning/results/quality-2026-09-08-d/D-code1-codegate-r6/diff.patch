diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..363834d 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,16 +16,35 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the current quantity; the stored
+        quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
+    def low_stock(self, threshold):
+        """Return the skus whose quantity is strictly below threshold.
+
+        Ordered by quantity ascending, ties broken by sku ascending.
+        """
+        return [
+            sku
+            for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+            if qty < threshold
+        ]
+
     def total(self):
         return sum(self._items.values())
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..1e92b87 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,79 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_less_than_available_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_exactly_available_returns_zero():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_more_than_available_raises_and_keeps_state():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg, f"message should name the sku: {msg!r}"
+        assert "3" in msg, f"message should state the remaining quantity: {msg!r}"
+    else:
+        assert False, "remove did not raise for qty > available"
+    # the failed remove must not have touched the quantity
+    assert s.quantity("apple") == 3
+    assert s.total() == 3
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    raised = False
+    try:
+        s.remove("ghost", 1)
+    except ValueError:
+        raised = True
+    assert raised, "remove did not raise for a sku that was never added"
+    assert s.quantity("ghost") == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 5)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+
+
+def test_low_stock_orders_by_quantity_then_sku():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 5)
+    s.add("cherry", 2)
+    s.add("date", 1)
+    s.add("elder", 10)
+    # strictly below 5: date(1), then banana(2) and cherry(2) tied -> by sku
+    assert s.low_stock(5) == ["date", "banana", "cherry"]
+
+
+def test_low_stock_excludes_equal_to_threshold():
+    s = Store()
+    s.add("apple", 5)
+    s.add("banana", 4)
+    assert s.low_stock(5) == ["banana"]
+    # nothing is strictly below 4
+    assert s.low_stock(4) == []
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(10) == []
