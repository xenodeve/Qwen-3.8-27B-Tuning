diff --git a/ledger/report.py b/ledger/report.py
index b9e410e..1f21cfa 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,17 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': the n most expensive entries of that month}, sorted by amount
+    descending, ties by category ascending. n < 0 raises ValueError."""
+    if n < 0:
+        raise ValueError(f"n must be >= 0, got {n}")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(month_entries, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, month_entries in sorted(by_month.items())
+    }
diff --git a/tests/test_ledger.py b/tests/test_ledger.py
index 2943ba6..821d08f 100644
--- a/tests/test_ledger.py
+++ b/tests/test_ledger.py
@@ -23,3 +23,80 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_amount_thousands_separator():
+    from ledger.parse import parse_amount
+    assert parse_amount("12,000.00") == 12000.0
+    assert parse_amount("1,250.00") == 1250.0
+    assert parse_amount("890") == 890.0
+
+
+def test_parse_amount_unparseable_raises():
+    from ledger.parse import parse_amount
+    try:
+        parse_amount("abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_reads_thousands(tmp_path):
+    p = tmp_path / "l.txt"
+    p.write_text(
+        "2026-08-03 | coffee | 45.50\n"
+        "2026-08-03 | rent | 12,000.00\n"
+        "2026-08-15 | groceries | 1,250.00\n"
+        "2026-08-20 | coffee | 45.50\n",
+        encoding="utf-8",
+    )
+    assert monthly_totals(load(p))["2026-08"] == 13341.0
+
+
+def test_top_returns_n_most_expensive():
+    from ledger import top
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+    ]
+    assert top(entries, 2) == {
+        "2026-08": [
+            {"date": "2026-08-03", "category": "rent", "amount": 12000.0},
+            {"date": "2026-08-15", "category": "groceries", "amount": 1250.0},
+        ],
+        "2026-09": [
+            {"date": "2026-09-01", "category": "rent", "amount": 12000.0},
+        ],
+    }
+
+
+def test_top_tie_breaks_by_category_ascending():
+    from ledger import top
+    entries = [
+        parse_line("2026-08-01 | zebra | 100"),
+        parse_line("2026-08-02 | apple | 100"),
+        parse_line("2026-08-03 | mango | 100"),
+    ]
+    assert [e["category"] for e in top(entries, 2)["2026-08"]] == ["apple", "mango"]
+
+
+def test_top_n_zero_is_empty():
+    from ledger import top
+    assert top([parse_line("2026-08-01 | a | 1")], 0) == {"2026-08": []}
+
+
+def test_top_n_larger_than_month_returns_all():
+    from ledger import top
+    entries = [parse_line("2026-08-01 | a | 5"), parse_line("2026-08-02 | b | 9")]
+    assert [e["category"] for e in top(entries, 10)["2026-08"]] == ["b", "a"]
+
+
+def test_top_negative_n_raises():
+    from ledger import top
+    try:
+        top([parse_line("2026-08-01 | a | 1")], -1)
+    except ValueError:
+        return
+    assert False
