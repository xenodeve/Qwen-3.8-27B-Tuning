@@ -20,6 +20,72 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_rejects_overdraw():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        assert "apple" in str(e)
+        assert "3" in str(e)
+    else:
+        assert False, "remove allowed overdraw"
+    assert s.quantity("apple") == 3
+    assert s.total() == 3
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    try:
+        s.remove("pear", 1)
+    except ValueError as e:
+        assert "pear" in str(e)
+        assert "0" in str(e)
+    else:
+        assert False, "remove allowed removing a missing sku"
+    assert s.quantity("pear") == 0
+    assert s.total() == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_exact_quantity_ok():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+
+
+def test_low_stock_orders_by_qty_then_sku():
+    s = Store()
+    s.add("banana", 1)
+    s.add("apple", 2)
+    s.add("cherry", 1)
+    s.add("date", 5)
+    assert s.low_stock(3) == ["banana", "cherry", "apple"]
+
+
+def test_low_stock_excludes_equal():
+    s = Store()
+    s.add("apple", 2)
+    s.add("pear", 3)
+    assert s.low_stock(3) == ["apple"]
+    assert s.low_stock(2) == []
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(5) == []
+
+
