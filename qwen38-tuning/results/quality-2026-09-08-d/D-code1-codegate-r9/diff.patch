diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..26fd1bd 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,32 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty would take the stock below zero; the stored
+        quantity is left unchanged when this happens.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is strictly below threshold.
+
+        Sorted by quantity ascending, ties broken by sku.
+        """
+        return [
+            sku
+            for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+            if qty < threshold
+        ]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..a20ab65 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -1,3 +1,5 @@
+import pytest
+
 from inventory import Store
 
 
@@ -27,3 +29,70 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_more_than_available_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    with pytest.raises(ValueError) as exc:
+        s.remove("apple", 5)
+    # message names the sku and the remaining quantity
+    assert "apple" in str(exc.value)
+    assert "3" in str(exc.value)
+    # the failed remove must not change the stored quantity
+    assert s.quantity("apple") == 3
+
+
+def test_remove_from_missing_sku_raises():
+    s = Store()
+    s.add("pear", 2)
+    with pytest.raises(ValueError) as exc:
+        s.remove("apple", 1)
+    assert "apple" in str(exc.value)
+    # apple was never added: quantity stays 0 and no negative key is created
+    assert s.quantity("apple") == 0
+    assert s.skus() == ["pear"]
+
+
+def test_remove_exact_and_partial_succeed():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 1) == 2
+    assert s.remove("apple", 2) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        with pytest.raises(ValueError):
+            s.remove("apple", bad)
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_filters_below_threshold():
+    s = Store()
+    s.add("apple", 1)
+    s.add("pear", 2)
+    s.add("plum", 5)
+    # strictly below threshold: apple(1), pear(2); plum(5) excluded
+    assert s.low_stock(3) == ["apple", "pear"]
+    # boundary: pear(2) is not < 2
+    assert s.low_stock(2) == ["apple"]
+    assert s.low_stock(6) == ["apple", "pear", "plum"]
+
+
+def test_low_stock_orders_by_qty_then_sku():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 2)
+    s.add("cherry", 1)
+    s.add("date", 4)
+    # threshold 4 excludes date(4); cherry(1) first, then apple/banana (both 2) by sku
+    assert s.low_stock(4) == ["cherry", "apple", "banana"]
+
+
+def test_low_stock_empty_store():
+    s = Store()
+    assert s.low_stock(5) == []
