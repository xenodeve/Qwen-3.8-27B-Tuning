diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..a0d92ec 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,30 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity in stock; the
+        store is left unchanged.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold, ordered by
+        quantity ascending, then by sku."""
+        return [
+            sku
+            for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+            if qty < threshold
+        ]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..fd4d157 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,57 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_insufficient_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove did not raise"
+    assert s.quantity("apple") == 3
+    assert s.total() == 3
+
+
+def test_remove_unknown_sku_raises():
+    s = Store()
+    try:
+        s.remove("pear", 1)
+    except ValueError as e:
+        assert "pear" in str(e)
+    else:
+        assert False, "remove did not raise"
+    assert s.quantity("pear") == 0
+
+
+def test_remove_exact_amount_succeeds():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_low_stock_orders_by_quantity_then_sku():
+    s = Store()
+    s.add("apple", 1)
+    s.add("banana", 2)
+    s.add("cherry", 2)
+    s.add("date", 5)
+    assert s.low_stock(3) == ["apple", "banana", "cherry"]
+
+
+def test_low_stock_excludes_at_and_above_threshold():
+    s = Store()
+    s.add("apple", 3)
+    s.add("banana", 4)
+    assert s.low_stock(3) == []
+    assert s.low_stock(4) == ["apple"]
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(5) == []
