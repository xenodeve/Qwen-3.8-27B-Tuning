--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,18 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': the n most expensive entries of that month}.
+
+    Each list is sorted by amount, most expensive first; equal amounts are
+    ordered by category. `n` larger than a month's entry count returns all of them.
+    """
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(month_entries, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, month_entries in sorted(by_month.items())
+    }
diff --git a/tests/test_ledger.py b/tests/test_ledger.py
