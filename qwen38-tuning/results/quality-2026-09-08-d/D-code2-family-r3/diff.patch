@@ -1,4 +1,4 @@
-from ledger import parse_line, load, monthly_totals
+from ledger import parse_line, load, monthly_totals, top
 
 
 def test_parse_line_basic():
@@ -23,3 +23,66 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_line_comma_thousands():
+    # `12,000.00` is twelve thousand, not twelve
+    e = parse_line("2026-08-03 | rent | 12,000.00")
+    assert e["amount"] == 12000.0
+
+
+def test_parse_line_unparseable_amount_raises():
+    # an amount that is not a real number must not silently count as 0
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_load_sample_monthly_totals():
+    # the reported bug: 2026-08 must be 13,341.00, not 91.00
+    assert monthly_totals(load("data/sample.txt")) == {
+        "2026-08": 13341.0,
+        "2026-09": 12890.0,
+    }
+
+
+def test_top_returns_month_to_top_n_desc():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+    ]
+    result = top(entries, 2)
+    assert set(result) == {"2026-08", "2026-09"}
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+    assert [e["amount"] for e in result["2026-08"]] == [12000.0, 1250.0]
+    assert result["2026-09"] == [
+        {"date": "2026-09-01", "category": "rent", "amount": 12000.0}
+    ]
+
+
+def test_top_tie_broken_by_category():
+    # equal amounts within a month sort by category ascending
+    entries = [
+        parse_line("2026-08-03 | zeta | 100"),
+        parse_line("2026-08-03 | alpha | 100"),
+        parse_line("2026-08-03 | mid | 100"),
+    ]
+    assert [e["category"] for e in top(entries, 3)["2026-08"]] == ["alpha", "mid", "zeta"]
+
+
+def test_top_n_greater_than_month_count():
+    # n larger than the month's entry count returns all entries, still sorted
+    entries = [
+        parse_line("2026-08-03 | b | 5"),
+        parse_line("2026-08-03 | a | 9"),
+    ]
+    assert [e["category"] for e in top(entries, 10)["2026-08"]] == ["a", "b"]
+
+
+def test_top_empty_entries():
+    assert top([], 5) == {}
