+
+
+def top(entries, n):
+    """{'YYYY-MM': [n most expensive entries]} for every month with at least one entry.
+
+    Within a month the entries are ordered expensive-first; ties break by
+    category (alphabetical). `n` must be a non-negative int."""
+    if not isinstance(n, int) or isinstance(n, bool):
+        raise TypeError(f"n must be an int, got {type(n).__name__}")
+    if n < 0:
+        raise ValueError(f"n must be >= 0, got {n}")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(month_entries, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, month_entries in sorted(by_month.items())
+    }
