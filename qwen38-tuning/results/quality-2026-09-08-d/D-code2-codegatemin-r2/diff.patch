 def test_parse_line_basic():
@@ -23,3 +24,79 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+# --- regression: thousands separators must not be dropped to zero ---
+
+def test_parse_amount_thousands_separator():
+    assert parse_amount("12,000.00") == 12000.0
+    assert parse_amount("1,250.00") == 1250.0
+
+
+def test_parse_amount_garbage_raises_not_zero():
+    try:
+        parse_amount("abc")
+    except ValueError:
+        return
+    assert False, "unparseable amount must raise, not count as zero"
+
+
+def test_sample_monthly_total():
+    # 2026-08: 45.50 + 12,000.00 + 1,250.00 + 45.50 = 13,341.00
+    assert monthly_totals(load("data/sample.txt")) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+# --- top() ---
+
+def test_top_orders_expensive_first_ties_by_category():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    got = top(entries, 2)
+    assert [e["category"] for e in got["2026-08"]] == ["rent", "groceries"]
+    assert [e["amount"] for e in got["2026-08"]] == [12000.0, 1250.0]
+
+
+def test_top_tie_breaks_by_category():
+    entries = [
+        parse_line("2026-08-03 | zebra | 10"),
+        parse_line("2026-08-04 | apple | 10"),
+    ]
+    got = top(entries, 2)
+    assert [e["category"] for e in got["2026-08"]] == ["apple", "zebra"]
+
+
+def test_top_n_zero_and_empty():
+    entries = [parse_line("2026-08-03 | coffee | 45.50")]
+    assert top(entries, 0) == {"2026-08": []}
+    assert top([], 3) == {}
+
+
+def test_top_rejects_non_int_n():
+    for bad in (1.5, "2", None, True):
+        try:
+            top([parse_line("2026-08-03 | coffee | 1")], bad)
+        except TypeError:
+            continue
+        assert False, f"n={bad!r} must raise TypeError"
+
+
+def test_top_rejects_negative_n():
+    try:
+        top([parse_line("2026-08-03 | coffee | 1")], -1)
+    except ValueError:
+        return
+    assert False, "negative n must raise ValueError"
+
+
+# --- error path: missing file ---
+
+def test_load_missing_file_raises(tmp_path):
+    try:
+        load(tmp_path / "nope.txt")
+    except FileNotFoundError:
+        return
+    assert False
