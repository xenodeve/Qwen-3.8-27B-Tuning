diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..7f5df99 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,30 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds what is in stock; the stored
+        quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} remaining"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold.
+
+        Sorted by quantity ascending; ties broken by sku.
+        """
+        low = [(sku, qty) for sku, qty in self._items.items() if qty < threshold]
+        low.sort(key=lambda kv: (kv[1], kv[0]))
+        return [sku for sku, _ in low]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..84f68a1 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,75 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_exact_qty_ok():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_raises_when_qty_exceeds_available():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        # message must name the sku and the remaining quantity
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove accepted qty greater than available"
+    # quantity must be unchanged after the failed remove
+    assert s.quantity("apple") == 3
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("pear", 1)
+    except ValueError as e:
+        assert "pear" in str(e)
+    else:
+        assert False, "remove accepted qty for a sku not in stock"
+    # the failed remove must not create the key
+    assert "pear" not in s.skus()
+    assert s.quantity("pear") == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_orders_by_qty_then_sku():
+    s = Store()
+    s.add("b", 1)
+    s.add("a", 1)
+    s.add("c", 2)
+    s.add("d", 5)
+    assert s.low_stock(3) == ["a", "b", "c"]
+    assert s.low_stock(6) == ["a", "b", "c", "d"]
+
+
+def test_low_stock_excludes_equal():
+    s = Store()
+    s.add("a", 3)
+    s.add("b", 2)
+    # qty == threshold is NOT low stock (strictly less than)
+    assert s.low_stock(3) == ["b"]
+
+
+def test_low_stock_empty():
+    s = Store()
+    assert s.low_stock(5) == []
