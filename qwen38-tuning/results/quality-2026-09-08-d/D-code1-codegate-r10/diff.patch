diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..dd4e099 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,27 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity in stock; the stored
+        quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold, fewest first (ties by sku)."""
+        below = [(qty, sku) for sku, qty in self._items.items() if qty < threshold]
+        below.sort()
+        return [sku for qty, sku in below]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..324d8f9 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -1,3 +1,5 @@
+import pytest
+
 from inventory import Store
 
 
@@ -27,3 +29,69 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_more_than_available_raises():
+    s = Store()
+    s.add("apple", 3)
+    with pytest.raises(ValueError) as exc:
+        s.remove("apple", 5)
+    # message must name the sku and the quantity that remains
+    msg = str(exc.value)
+    assert "apple" in msg
+    assert "3" in msg
+    # quantity must be unchanged after the failed removal
+    assert s.quantity("apple") == 3
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_exact_and_partial():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    with pytest.raises(ValueError):
+        s.remove("pear", 1)
+    assert s.quantity("pear") == 0
+
+
+def test_low_stock_orders_by_quantity_then_sku():
+    s = Store()
+    s.add("apple", 2)
+    s.add("banana", 1)
+    s.add("cherry", 1)
+    s.add("date", 5)
+    # qty < 3: banana(1), cherry(1), apple(2); ties broken by sku
+    assert s.low_stock(3) == ["banana", "cherry", "apple"]
+
+
+def test_low_stock_excludes_equal_to_threshold():
+    s = Store()
+    s.add("apple", 3)
+    s.add("banana", 2)
+    # strictly less than threshold: apple (== 3) is excluded
+    assert s.low_stock(3) == ["banana"]
+
+
+def test_low_stock_empty_when_none_below():
+    s = Store()
+    s.add("apple", 5)
+    assert s.low_stock(5) == []
+    assert Store().low_stock(10) == []
