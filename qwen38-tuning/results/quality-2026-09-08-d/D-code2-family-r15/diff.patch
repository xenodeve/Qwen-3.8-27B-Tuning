-from ledger import parse_line, load, monthly_totals
+from pathlib import Path
+
+from ledger import parse_line, parse_amount, load, monthly_totals, top
 
 
 def test_parse_line_basic():
@@ -23,3 +25,67 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_amount_strips_thousands_commas():
+    assert parse_amount("12,000.00") == 12000.0
+    assert parse_amount("1,250.00") == 1250.0
+
+
+def test_parse_amount_rejects_garbage():
+    for bad in ("abc", "12.34.56"):
+        try:
+            parse_amount(bad)
+        except ValueError:
+            continue
+        assert False, f"{bad!r} did not raise"
+
+
+def test_parse_amount_rejects_empty():
+    try:
+        parse_amount("   ")
+    except ValueError:
+        return
+    assert False
+
+
+def test_load_sample_totals(tmp_path):
+    p = tmp_path / "sample.txt"
+    p.write_text(Path("data/sample.txt").read_text(encoding="utf-8"), encoding="utf-8")
+    assert monthly_totals(load(p)) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_top_orders_by_amount_then_category():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+        parse_line("2026-09-02 | books | 890"),
+    ]
+    assert top(entries, 2) == {
+        "2026-08": [
+            {"date": "2026-08-03", "category": "rent", "amount": 12000.0},
+            {"date": "2026-08-15", "category": "groceries", "amount": 1250.0},
+        ],
+        "2026-09": [
+            {"date": "2026-09-01", "category": "rent", "amount": 12000.0},
+            {"date": "2026-09-02", "category": "books", "amount": 890.0},
+        ],
+    }
+
+
+def test_top_tie_broken_by_category():
+    entries = [
+        parse_line("2026-08-05 | zeta | 10"),
+        parse_line("2026-08-01 | alpha | 10"),
+        parse_line("2026-08-09 | beta | 10"),
+    ]
+    assert [e["category"] for e in top(entries, 3)["2026-08"]] == ["alpha", "beta", "zeta"]
+
+
+def test_top_zero_and_more_than_available():
+    entries = [parse_line("2026-08-03 | coffee | 45.50")]
+    assert top(entries, 0) == {"2026-08": []}
+    assert top(entries, 5) == {"2026-08": [{"date": "2026-08-03", "category": "coffee", "amount": 45.5}]}
