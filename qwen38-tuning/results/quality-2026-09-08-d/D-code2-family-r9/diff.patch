+from ledger import parse_line, load, monthly_totals, top
 
 
 def test_parse_line_basic():
@@ -23,3 +23,66 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_line_thousands_separator():
+    e = parse_line("2026-08-03 | rent | 12,000.00")
+    assert e["amount"] == 12000.0
+
+
+def test_parse_line_rejects_unparseable_amount():
+    for bad in ("abc", "", "12.34.56", "12..50"):
+        try:
+            parse_line(f"2026-08-03 | coffee | {bad}")
+        except ValueError:
+            continue
+        raise AssertionError(f"expected ValueError for amount {bad!r}")
+
+
+def test_monthly_totals_on_sample_data():
+    assert monthly_totals(load("data/sample.txt")) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_top_orders_by_amount_desc():
+    entries = [
+        parse_line("2026-08-01 | coffee | 10.00"),
+        parse_line("2026-08-02 | rent | 12000.00"),
+        parse_line("2026-08-03 | books | 890.00"),
+    ]
+    assert [e["category"] for e in top(entries, 2)["2026-08"]] == ["rent", "books"]
+
+
+def test_top_tie_broken_by_category():
+    entries = [
+        parse_line("2026-08-01 | zebra | 50.00"),
+        parse_line("2026-08-02 | apple | 50.00"),
+        parse_line("2026-08-03 | mango | 50.00"),
+    ]
+    assert [e["category"] for e in top(entries, 3)["2026-08"]] == ["apple", "mango", "zebra"]
+
+
+def test_top_limits_to_n():
+    entries = [parse_line(f"2026-08-0{i} | c{i} | {i * 10}.00") for i in range(1, 5)]
+    assert len(top(entries, 2)["2026-08"]) == 2
+    assert [e["amount"] for e in top(entries, 2)["2026-08"]] == [40.0, 30.0]
+
+
+def test_top_zero_and_negative():
+    entries = [parse_line("2026-08-01 | coffee | 10.00")]
+    assert top(entries, 0) == {"2026-08": []}
+    try:
+        top(entries, -1)
+    except ValueError:
+        return
+    raise AssertionError("expected ValueError for negative n")
+
+
+def test_top_covers_each_month():
+    entries = [
+        parse_line("2026-08-01 | coffee | 10.00"),
+        parse_line("2026-09-01 | rent | 12000.00"),
+    ]
+    result = top(entries, 1)
+    assert set(result) == {"2026-08", "2026-09"}
+    assert result["2026-09"][0]["category"] == "rent"
+    assert result["2026-08"][0]["category"] == "coffee"
