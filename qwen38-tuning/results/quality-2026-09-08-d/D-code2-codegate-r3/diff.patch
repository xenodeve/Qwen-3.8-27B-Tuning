@@ -8,3 +8,20 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': up to n entries} for every month that has at least one entry.
+
+    Within a month, entries are ordered by amount descending; equal amounts are
+    ordered by category ascending. n must be a non-negative integer.
+    """
+    if n < 0:
+        raise ValueError(f"n must be non-negative, got {n}")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(months, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, months in sorted(by_month.items())
+    }
diff --git a/tests/test_ledger.py b/tests/test_ledger.py
index 2943ba6..8cab5e3 100644
--- a/tests/test_ledger.py
+++ b/tests/test_ledger.py
@@ -1,4 +1,4 @@
-from ledger import parse_line, load, monthly_totals
+from ledger import parse_line, load, monthly_totals, parse_amount, top
 
 
 def test_parse_line_basic():
@@ -23,3 +23,74 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_amount_thousands_separator():
+    assert parse_amount("12,000.00") == 12000.0
+    assert parse_amount("1,250.00") == 1250.0
+
+
+def test_parse_amount_plain_values():
+    assert parse_amount("45.50") == 45.5
+    assert parse_amount("890") == 890.0
+
+
+def test_parse_amount_unparseable_raises():
+    try:
+        parse_amount("abc")
+    except ValueError:
+        return
+    assert False, "unparseable amount must raise ValueError, not be counted as zero"
+
+
+def test_load_skips_unparseable_amount_lines(tmp_path):
+    p = tmp_path / "l.txt"
+    p.write_text("2026-08-03 | coffee | 45.50\n2026-08-04 | junk | not-a-number\n", encoding="utf-8")
+    entries = load(p)
+    assert len(entries) == 1
+    assert entries[0]["amount"] == 45.5
+
+
+def test_top_orders_by_amount_desc():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    result = top(entries, 3)
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries", "coffee"]
+
+
+def test_top_tie_broken_by_category():
+    entries = [
+        parse_line("2026-08-03 | zebra | 100"),
+        parse_line("2026-08-04 | apple | 100"),
+        parse_line("2026-08-05 | mango | 50"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["apple", "zebra"]
+
+
+def test_top_groups_by_month():
+    entries = [
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-09-01 | books | 890"),
+    ]
+    result = top(entries, 1)
+    assert set(result) == {"2026-08", "2026-09"}
+    assert [e["category"] for e in result["2026-08"]] == ["rent"]
+    assert [e["category"] for e in result["2026-09"]] == ["books"]
+
+
+def test_top_n_zero_gives_empty_lists():
+    entries = [parse_line("2026-08-03 | coffee | 45.50")]
+    assert top(entries, 0) == {"2026-08": []}
+
+
+def test_top_negative_n_raises():
+    try:
+        top([], -1)
+    except ValueError:
+        return
+    assert False, "negative n must raise ValueError"
