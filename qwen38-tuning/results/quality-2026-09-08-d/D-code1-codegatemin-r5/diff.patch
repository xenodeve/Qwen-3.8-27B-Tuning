diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..672e389 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,16 +16,30 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity in stock; the stored
+        quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(f"cannot remove {qty} of {sku!r}: only {current} in stock")
         self._items[sku] = current - qty
         return self._items[sku]
 
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold, fewest first.
+
+        Skus with equal quantity are ordered by sku.
+        """
+        below = sorted((qty, sku) for sku, qty in self._items.items() if qty < threshold)
+        return [sku for _, sku in below]
+
     def total(self):
         return sum(self._items.values())
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..11c4f5c 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,90 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_exact_amount_ok():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_too_much_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        # message names the sku and the available quantity
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove did not raise for qty > available"
+    # stored quantity is unchanged after the failed remove
+    assert s.quantity("apple") == 3
+    assert s.total() == 3
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError as e:
+        assert "ghost" in str(e)
+    else:
+        assert False, "remove did not raise for a missing sku"
+    # no negative entry is created
+    assert s.quantity("ghost") == 0
+    assert "ghost" not in s.skus()
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_basic():
+    s = Store()
+    s.add("apple", 1)
+    s.add("pear", 5)
+    s.add("plum", 2)
+    # threshold 3 -> apple (1) and plum (2) are below; pear (5) is not
+    assert s.low_stock(3) == ["apple", "plum"]
+
+
+def test_low_stock_ordering_by_qty_then_sku():
+    s = Store()
+    # equal quantities must order by sku; different quantities by qty
+    s.add("banana", 2)
+    s.add("apple", 2)
+    s.add("zeta", 1)
+    s.add("mid", 3)
+    assert s.low_stock(4) == ["zeta", "apple", "banana", "mid"]
+
+
+def test_low_stock_boundary_is_strictly_less():
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 2)
+    # qty == threshold is NOT low stock; only strictly below counts
+    assert s.low_stock(3) == ["pear"]
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(5) == []
+
+
+def test_low_stock_none_below():
+    s = Store()
+    s.add("apple", 10)
+    s.add("pear", 20)
+    assert s.low_stock(5) == []
