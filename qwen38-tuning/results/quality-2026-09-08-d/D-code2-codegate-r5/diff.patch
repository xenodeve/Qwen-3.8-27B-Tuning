diff --git a/ledger/report.py b/ledger/report.py
index b9e410e..5acc3cc 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,22 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [up to n entries]} for each month that has at least one entry.
+
+    Within a month the entries are ordered by amount descending, ties broken by
+    category ascending. `n` must be a non-negative int.
+    """
+    if isinstance(n, bool) or not isinstance(n, int):
+        raise TypeError(f"n must be an int, got {type(n).__name__}")
+    if n < 0:
+        raise ValueError(f"n must be >= 0, got {n}")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(months, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, months in sorted(by_month.items())
+    }
diff --git a/tests/test_ledger.py b/tests/test_ledger.py
index 2943ba6..524c1ea 100644
--- a/tests/test_ledger.py
+++ b/tests/test_ledger.py
@@ -23,3 +23,106 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_line_strips_thousands_commas():
+    e = parse_line("2026-08-03 | rent | 12,000.00")
+    assert e["amount"] == 12000.0
+
+
+def test_parse_line_rejects_unparseable_amount():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_load_missing_file_raises(tmp_path):
+    try:
+        load(tmp_path / "nope.txt")
+    except FileNotFoundError:
+        return
+    assert False
+
+
+def test_monthly_totals_sample_file():
+    from pathlib import Path
+    path = Path(__file__).resolve().parent.parent / "data" / "sample.txt"
+    assert monthly_totals(load(path)) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_top_returns_top_n_by_amount_desc():
+    from ledger import top
+    entries = [
+        parse_line("2026-08-01 | coffee | 10"),
+        parse_line("2026-08-02 | rent | 500"),
+        parse_line("2026-08-03 | books | 200"),
+    ]
+    result = top(entries, 2)
+    assert list(result) == ["2026-08"]
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "books"]
+    assert [e["amount"] for e in result["2026-08"]] == [500.0, 200.0]
+
+
+def test_top_ties_broken_by_category():
+    from ledger import top
+    entries = [
+        parse_line("2026-08-01 | zeta | 100"),
+        parse_line("2026-08-02 | alpha | 100"),
+        parse_line("2026-08-03 | mid | 50"),
+    ]
+    result = top(entries, 3)
+    assert [e["category"] for e in result["2026-08"]] == ["alpha", "zeta", "mid"]
+
+
+def test_top_groups_per_month():
+    from ledger import top
+    entries = [
+        parse_line("2026-08-01 | a | 10"),
+        parse_line("2026-09-01 | z | 999"),
+        parse_line("2026-09-02 | b | 5"),
+    ]
+    result = top(entries, 1)
+    assert set(result) == {"2026-08", "2026-09"}
+    assert [e["category"] for e in result["2026-08"]] == ["a"]
+    assert [e["category"] for e in result["2026-09"]] == ["z"]
+
+
+def test_top_n_larger_than_month_returns_all():
+    from ledger import top
+    entries = [
+        parse_line("2026-08-01 | a | 10"),
+        parse_line("2026-08-02 | b | 20"),
+    ]
+    result = top(entries, 5)
+    assert [e["category"] for e in result["2026-08"]] == ["b", "a"]
+
+
+def test_top_zero_n_returns_empty_lists():
+    from ledger import top
+    entries = [parse_line("2026-08-01 | a | 10")]
+    assert top(entries, 0) == {"2026-08": []}
+
+
+def test_top_empty_entries_returns_empty_dict():
+    from ledger import top
+    assert top([], 3) == {}
+
+
+def test_top_negative_n_raises():
+    from ledger import top
+    try:
+        top([], -1)
+    except ValueError:
+        return
+    assert False
+
+
+def test_top_non_int_n_raises():
+    from ledger import top
+    try:
+        top([], 1.5)
+    except TypeError:
+        return
+    assert False
