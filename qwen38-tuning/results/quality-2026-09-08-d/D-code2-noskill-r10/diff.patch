 def test_parse_line_basic():
@@ -23,3 +25,49 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_amount_strips_thousands_separator():
+    assert parse_line("2026-08-03 | rent | 12,000.00")["amount"] == 12000.0
+    assert parse_line("2026-08-15 | groceries | 1,250.00")["amount"] == 1250.0
+
+
+def test_sample_august_total_is_correct():
+    entries = load(os.path.join("data", "sample.txt"))
+    assert monthly_totals(entries)["2026-08"] == 13341.0
+
+
+def test_unparseable_amount_raises():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_top_returns_most_expensive_per_month():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-09-02 | books | 890"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+    assert [e["amount"] for e in result["2026-08"]] == [12000.0, 1250.0]
+    assert [e["category"] for e in result["2026-09"]] == ["books"]
+
+
+def test_top_breaks_ties_by_category():
+    entries = [
+        parse_line("2026-08-03 | zebra | 100"),
+        parse_line("2026-08-04 | apple | 100"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["apple", "zebra"]
+
+
+def test_top_returns_all_when_n_exceeds_count():
+    entries = [parse_line("2026-08-03 | coffee | 45.50")]
+    result = top(entries, 5)
+    assert len(result["2026-08"]) == 1
