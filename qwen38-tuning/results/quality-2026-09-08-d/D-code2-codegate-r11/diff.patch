     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [the n most expensive entries of that month]}.
+
+    Sorted most expensive first; ties on amount are broken by category
+    (ascending). Months with fewer than n entries list all of them.
+    """
+    if isinstance(n, bool) or not isinstance(n, int):
+        raise TypeError(f"n must be an int, got {type(n).__name__}")
+    if n < 0:
+        raise ValueError("n must be >= 0")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(items, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, items in sorted(by_month.items())
+    }
