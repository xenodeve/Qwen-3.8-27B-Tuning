+
+def test_parse_amount_strips_thousands_commas():
+    e = parse_line("2026-08-03 | rent | 12,000.00")
+    assert e["amount"] == 12000.0
+
+
+def test_parse_line_rejects_unreadable_amount():
+    # an amount we cannot read is an error, never a silent zero
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_with_comma_amounts():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    assert monthly_totals(entries) == {"2026-08": 13341.0}
+
+
+def test_load_missing_file_raises(tmp_path):
+    try:
+        load(tmp_path / "nope.txt")
+    except FileNotFoundError:
+        return
+    assert False
+
+
+def test_top_returns_top_n_per_month_expensive_first():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    got = top(entries, 2)
+    assert list(got) == ["2026-08"]
+    assert [e["category"] for e in got["2026-08"]] == ["rent", "groceries"]
+
+
+def test_top_ties_broken_by_category():
+    entries = [
+        parse_line("2026-08-03 | zeta | 100"),
+        parse_line("2026-08-04 | alpha | 100"),
+        parse_line("2026-08-05 | mid | 100"),
+    ]
+    got = top(entries, 3)
+    assert [e["category"] for e in got["2026-08"]] == ["alpha", "mid", "zeta"]
+
+
+def test_top_n_larger_than_month_returns_all():
