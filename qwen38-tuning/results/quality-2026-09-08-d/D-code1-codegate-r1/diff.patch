diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..2bbd1a9 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,25 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty would take the stock below zero.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(f"cannot remove {qty} of {sku!r}: only {current} in stock")
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold, fewest first; ties by sku."""
+        return sorted(
+            (sku for sku, qty in self._items.items() if qty < threshold),
+            key=lambda sku: (self._items[sku], sku),
+        )
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..7199b34 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,80 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_all_leaves_zero():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_more_than_available_raises():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 4)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove accepted more than is in stock"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_more_than_available_missing_sku():
+    s = Store()
+    try:
+        s.remove("pear", 1)
+    except ValueError as e:
+        assert "pear" in str(e)
+    else:
+        assert False, "remove accepted from an empty stock"
+    assert s.quantity("pear") == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_filters_below_threshold():
+    s = Store()
+    s.add("apple", 2)
+    s.add("pear", 5)
+    s.add("plum", 1)
+    assert s.low_stock(3) == ["plum", "apple"]
+
+
+def test_low_stock_excludes_equal():
+    s = Store()
+    s.add("apple", 3)
+    assert s.low_stock(3) == []
+
+
+def test_low_stock_ties_sorted_by_sku():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 2)
+    s.add("cherry", 1)
+    assert s.low_stock(3) == ["cherry", "apple", "banana"]
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(5) == []
