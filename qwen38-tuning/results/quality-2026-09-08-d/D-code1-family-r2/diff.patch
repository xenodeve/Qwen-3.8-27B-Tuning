+def test_remove_more_than_available_raises_and_keeps_state():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove accepted more than available"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    try:
+        s.remove("banana", 1)
+    except ValueError as e:
+        assert "banana" in str(e)
+    else:
+        assert False, "remove accepted a sku that was never added"
+    assert s.quantity("banana") == 0
+
+
+def test_remove_partial_and_exact():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 1) == 2
+    assert s.remove("apple", 2) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_low_stock_filters_and_orders():
+    s = Store()
+    s.add("apple", 2)
+    s.add("banana", 5)
+    s.add("cherry", 1)
+    s.add("date", 3)
+    assert s.low_stock(3) == ["cherry", "apple"]
+
+
+def test_low_stock_ties_broken_by_sku():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 2)
+    s.add("cherry", 1)
+    assert s.low_stock(3) == ["cherry", "apple", "banana"]
+
+
+def test_low_stock_empty_when_all_above_threshold():
+    s = Store()
+    s.add("apple", 3)
+    assert s.low_stock(3) == []
+    assert s.low_stock(0) == []
+
+
