--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,16 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [top n entries of that month]} for every month that has at least
+    one entry. Within a month, entries are ordered most expensive first; ties are
+    broken by category (ascending)."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(month_entries, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, month_entries in sorted(by_month.items())
+    }
