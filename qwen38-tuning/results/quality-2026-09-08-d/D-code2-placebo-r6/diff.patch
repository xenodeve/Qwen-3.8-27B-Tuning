+
+
+def test_parse_amount_thousands_separator():
+    assert parse_amount("12,000.00") == 12000.0
+    assert parse_amount("1,250.00") == 1250.0
+
+
+def test_parse_amount_plain_and_decimal():
+    assert parse_amount("45.50") == 45.5
+    assert parse_amount("890") == 890.0
+
+
+def test_parse_amount_rejects_garbage():
+    for bad in ("abc", "12.34.56", "1,23", "12,,00", "1.2,34", ""):
+        try:
+            parse_amount(bad)
+        except ValueError:
+            pass
+        else:
+            assert False, f"{bad!r} should have raised ValueError"
+
+
+def test_parse_line_rejects_unparseable_amount():
+    try:
+        parse_line("2026-08-03 | coffee | n/a")
+    except ValueError:
+        return
+    assert False
+
+
+def test_sample_file_august_total():
+    # 45.50 + 12,000.00 + 1,250.00 + 45.50 = 13,341.00
+    assert monthly_totals(load("data/sample.txt"))["2026-08"] == 13341.0
+
+
+def test_top_orders_by_amount_desc():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+
+
+def test_top_ties_break_by_category():
+    entries = [
+        parse_line("2026-08-03 | zeta | 100"),
+        parse_line("2026-08-04 | alpha | 100"),
+        parse_line("2026-08-05 | mid | 100"),
+    ]
+    assert [e["category"] for e in top(entries, 3)["2026-08"]] == ["alpha", "mid", "zeta"]
+
+
+def test_top_limits_to_n():
