+from ledger import parse_line, load, monthly_totals, top
 
 
 def test_parse_line_basic():
@@ -23,3 +23,78 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_amount_thousands_commas():
+    e = parse_line("2026-08-03 | rent | 12,000.00")
+    assert e["amount"] == 12000.0
+
+
+def test_parse_amount_garbage_raises():
+    # an unparseable amount must not be counted as 0
+    try:
+        parse_line("2026-08-03 | coffee | N/A")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_with_comma_amounts():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    assert monthly_totals(entries) == {"2026-08": 13341.0}
+
+
+def test_top_returns_dict_by_month():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-09-02 | books | 890"),
+    ]
+    got = top(entries, 2)
+    assert set(got) == {"2026-08", "2026-09"}
+    assert [e["category"] for e in got["2026-08"]] == ["rent", "groceries"]
+    assert [e["category"] for e in got["2026-09"]] == ["books"]
+
+
+def test_top_orders_expensive_to_cheap():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+    ]
+    got = top(entries, 2)
+    assert [e["category"] for e in got["2026-08"]] == ["rent", "groceries"]
+
+
+def test_top_ties_broken_by_category():
+    entries = [
+        parse_line("2026-08-01 | zeta | 100"),
+        parse_line("2026-08-02 | alpha | 100"),
+        parse_line("2026-08-03 | mid | 100"),
+    ]
+    got = top(entries, 3)
+    assert [e["category"] for e in got["2026-08"]] == ["alpha", "mid", "zeta"]
+
+
+def test_top_n_zero_returns_empty_lists():
+    entries = [parse_line("2026-08-03 | rent | 12,000.00")]
+    assert top(entries, 0) == {"2026-08": []}
+
+
+def test_top_n_larger_than_entries_returns_all():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+    ]
+    got = top(entries, 10)
+    assert [e["category"] for e in got["2026-08"]] == ["rent", "coffee"]
+
+
+def test_top_no_entries_returns_empty_dict():
+    assert top([], 3) == {}
