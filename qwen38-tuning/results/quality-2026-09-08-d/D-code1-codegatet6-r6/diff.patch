diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..37975e1 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,25 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty would take the quantity below zero; the
+        stored quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(f"cannot remove {qty} of {sku!r}: only {current} in stock")
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus with quantity strictly below threshold, ordered by
+        quantity ascending, then by sku for ties."""
+        return [sku for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+                if qty < threshold]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..0bbdb45 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,73 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_rejects_more_than_in_stock():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove accepted qty above stock"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_unknown_sku_raises_and_leaves_store_unchanged():
+    s = Store()
+    s.add("pear", 2)
+    try:
+        s.remove("ghost", 1)
+    except ValueError as e:
+        msg = str(e)
+        assert "ghost" in msg
+        assert "0" in msg
+    else:
+        assert False, "remove accepted qty for unknown sku"
+    assert s.quantity("pear") == 2
+    assert s.skus() == ["pear"]
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_exact_amount_ok():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+
+
+def test_low_stock_orders_by_qty_then_sku():
+    s = Store()
+    s.add("banana", 1)
+    s.add("apple", 2)
+    s.add("cherry", 2)
+    s.add("date", 5)
+    assert s.low_stock(3) == ["banana", "apple", "cherry"]
+
+
+def test_low_stock_strictly_below_threshold():
+    s = Store()
+    s.add("apple", 3)
+    assert s.low_stock(3) == []
+    assert s.low_stock(4) == ["apple"]
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(5) == []
+    s = Store()
+    s.add("apple", 3)
+    assert s.low_stock(0) == []
