diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..71776cd 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,16 +16,30 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds what is in stock; the store is
+        left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(f"cannot remove {qty} of {sku!r}: only {current} left")
         self._items[sku] = current - qty
         return self._items[sku]
 
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
+    def low_stock(self, threshold):
+        """SKUs whose quantity is strictly below threshold, fewest units first.
+
+        Ties are broken by sku, ascending.
+        """
+        low = [(sku, qty) for sku, qty in self._items.items() if qty < threshold]
+        return [sku for sku, qty in sorted(low, key=lambda kv: (kv[1], kv[0]))]
+
     def total(self):
         return sum(self._items.values())
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..af8c66c 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,92 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_happy_path():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_exactly_all():
+    s = Store()
+    s.add("apple", 4)
+    assert s.remove("apple", 4) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_more_than_available_raises():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove did not raise for qty > available"
+
+
+def test_remove_unknown_sku_raises():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError as e:
+        assert "ghost" in str(e)
+    else:
+        assert False, "remove did not raise for unknown sku"
+
+
+def test_remove_unchanged_after_raise():
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 2)
+    try:
+        s.remove("apple", 10)
+    except ValueError:
+        pass
+    else:
+        assert False, "remove did not raise"
+    assert s.quantity("apple") == 3
+    assert s.quantity("pear") == 2
+    assert s.total() == 5
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_filters_below_threshold():
+    s = Store()
+    s.add("apple", 2)
+    s.add("pear", 5)
+    s.add("plum", 1)
+    assert s.low_stock(3) == ["plum", "apple"]
+    # exactly at threshold is not "low"
+    s.add("plum", 1)  # plum -> 2, apple -> 2
+    assert s.low_stock(2) == []
+
+
+def test_low_stock_sorted_by_qty_then_sku():
+    s = Store()
+    s.add("banana", 1)
+    s.add("apple", 1)
+    s.add("cherry", 2)
+    s.add("date", 1)
+    s.remove("date", 1)  # date -> 0
+    assert s.low_stock(3) == ["date", "apple", "banana", "cherry"]
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(5) == []
