diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..ce0153c 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,32 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the stock on hand; the stock is
+        left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus with quantity strictly below threshold.
+
+        Sorted by quantity ascending, ties broken by sku.
+        """
+        return [
+            sku
+            for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+            if qty < threshold
+        ]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..cf9d97e 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -20,6 +20,75 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_rejects_oversized_qty():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg  # the remaining quantity
+        assert s.quantity("apple") == 3  # state unchanged
+        return
+    assert False, "remove accepted qty greater than stock"
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError as e:
+        assert "ghost" in str(e)
+        assert s.quantity("ghost") == 0
+        return
+    assert False, "remove accepted qty for unknown sku"
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_exact_stock_ok():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_low_stock_orders_by_qty_then_sku():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 1)
+    s.add("cherry", 1)
+    s.add("date", 5)
+    assert s.low_stock(3) == ["apple", "cherry", "banana"]
+
+
+def test_low_stock_strictly_less_than():
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 2)
+    assert s.low_stock(3) == ["pear"]
+    assert s.low_stock(2) == []
+    assert s.low_stock(4) == ["pear", "apple"]
+
+
+def test_low_stock_empty_and_zero_threshold():
+    s = Store()
+    assert s.low_stock(5) == []
+    s.add("apple", 3)
+    assert s.low_stock(0) == []
+
+
