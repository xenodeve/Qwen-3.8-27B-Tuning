diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..f4bf085 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -20,9 +20,17 @@ class Store:
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(f"cannot remove {qty} of {sku!r}: only {current} left")
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold, fewest first (ties by sku)."""
+        below = [(sku, qty) for sku, qty in self._items.items() if qty < threshold]
+        below.sort(key=lambda item: (item[1], item[0]))
+        return [sku for sku, _ in below]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..7bdbbdd 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -20,6 +20,57 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_rejects_more_than_available():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (4, 100):
+        try:
+            s.remove("apple", bad)
+        except ValueError as exc:
+            assert "apple" in str(exc)
+            assert "3" in str(exc)
+            continue
+        assert False, f"remove accepted qty {bad}"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_unknown_sku_raises():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError as exc:
+        assert "ghost" in str(exc)
+        return
+    assert False, "remove accepted unknown sku"
+
+
+def test_low_stock_orders_by_quantity_then_sku():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 1)
+    s.add("cherry", 1)
+    s.add("date", 5)
+    assert s.low_stock(5) == ["apple", "cherry", "banana"]
+
+
+def test_low_stock_excludes_equal_to_threshold():
+    s = Store()
+    s.add("apple", 5)
+    s.add("banana", 4)
+    assert s.low_stock(5) == ["banana"]
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(10) == []
+
+
