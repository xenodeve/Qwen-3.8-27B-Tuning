@@ -8,3 +8,17 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [top n entries]} for every month that has at least one entry.
+
+    Within a month the entries are ordered by amount, highest first; ties are
+    broken by category, ascending. Fewer than n entries means the whole month."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(month_entries, key=lambda e: (-e["amount"], e["category"]))[: max(n, 0)]
+        for month, month_entries in sorted(by_month.items())
+    }
