+from ledger import parse_line, load, monthly_totals, top
+from ledger.parse import parse_amount
 
 
 def test_parse_line_basic():
@@ -23,3 +24,63 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_amount_comma_thousands():
+    assert parse_amount("12,000.00") == 12000.0
+    assert parse_amount("1,250.00") == 1250.0
+
+
+def test_parse_amount_unparseable_raises():
+    for bad in ("abc", "1.2.3", "", "12a"):
+        try:
+            parse_amount(bad)
+        except ValueError:
+            continue
+        assert False, f"parse_amount({bad!r}) should raise ValueError"
+
+
+def test_parse_line_empty_amount_raises():
+    try:
+        parse_line("2026-08-03 | coffee |")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_sample_file():
+    assert monthly_totals(load("data/sample.txt"))["2026-08"] == 13341.0
+
+
+def test_top_returns_top_n_by_amount():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-05 | rent | 12,000.00"),
+        parse_line("2026-08-07 | books | 890"),
+    ]
+    top3 = top(entries, 3)["2026-08"]
+    assert [e["category"] for e in top3] == ["rent", "books", "coffee"]
+
+
+def test_top_tie_breaks_by_category():
+    entries = [
+        parse_line("2026-08-03 | zeta | 100"),
+        parse_line("2026-08-04 | alpha | 100"),
+        parse_line("2026-08-05 | beta | 100"),
+    ]
+    top2 = top(entries, 2)["2026-08"]
+    assert [e["category"] for e in top2] == ["alpha", "beta"]
+
+
+def test_top_n_larger_than_month_returns_all():
+    entries = [parse_line("2026-08-03 | coffee | 45.50")]
+    assert len(top(entries, 5)["2026-08"]) == 1
+
+
+def test_top_empty_entries():
+    assert top([], 3) == {}
+
+
+def test_top_n_zero():
+    entries = [parse_line("2026-08-03 | coffee | 45.50")]
+    assert top(entries, 0) == {"2026-08": []}
