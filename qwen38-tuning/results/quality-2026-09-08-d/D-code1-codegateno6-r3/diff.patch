diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..e6c1abf 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,32 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the available quantity; the
+        stored quantity is left unchanged.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} available"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is strictly below threshold.
+
+        Ordered by quantity ascending, ties broken by sku ascending.
+        """
+        return [
+            sku
+            for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+            if qty < threshold
+        ]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..9314a67 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,79 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_rejects_overdraw():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove allowed an overdraw"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    raised = False
+    try:
+        s.remove("pear", 1)
+    except ValueError:
+        raised = True
+    assert raised, "remove allowed removing a missing sku"
+    assert s.quantity("pear") == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_filters_and_orders():
+    s = Store()
+    s.add("apple", 1)
+    s.add("pear", 4)
+    s.add("plum", 1)
+    s.add("kiwi", 2)
+    assert s.low_stock(3) == ["apple", "plum", "kiwi"]
+
+
+def test_low_stock_ties_broken_by_sku():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 2)
+    assert s.low_stock(3) == ["apple", "banana"]
+
+
+def test_low_stock_excludes_equal():
+    s = Store()
+    s.add("apple", 3)
+    assert s.low_stock(3) == []
+
+
+def test_low_stock_threshold_zero_empty():
+    s = Store()
+    s.add("apple", 1)
+    assert s.low_stock(0) == []
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(5) == []
