--- a/tests/test_ledger.py
+++ b/tests/test_ledger.py
@@ -1,4 +1,5 @@
 from ledger import parse_line, load, monthly_totals
+from ledger.parse import parse_amount
 
 
 def test_parse_line_basic():
@@ -23,3 +24,74 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+# --- thousands separators in amounts ---
+
+def test_parse_amount_thousands_separator():
+    assert parse_amount("1,250.00") == 1250.0
+    assert parse_amount("12,000.00") == 12000.0
+
+
+def test_monthly_totals_comma_amounts():
+    # the reported bug: rent 12,000.00 was being read as 0.0
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    assert monthly_totals(entries) == {"2026-08": 13341.0}
+
+
+# --- an unparseable amount must raise, not count as 0 ---
+
+def test_parse_amount_unparseable_raises():
+    try:
+        parse_amount("abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_parse_line_unparseable_amount_raises():
+    try:
+        parse_line("2026-08-03 | coffee | not-a-number")
+    except ValueError:
+        return
+    assert False
+
+
+# --- top(entries, n) ---
+
+def test_top_returns_month_to_top_n():
+    from ledger import top
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+    ]
+    result = top(entries, 2)
+    assert set(result) == {"2026-08", "2026-09"}
+    # most expensive first
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+    assert result["2026-09"] == [parse_line("2026-09-01 | rent | 12,000.00")]
+
+
+def test_top_ties_broken_by_category():
+    from ledger import top
+    entries = [
+        parse_line("2026-08-03 | zebra | 100.00"),
+        parse_line("2026-08-04 | apple | 100.00"),
+        parse_line("2026-08-05 | mango | 100.00"),
+    ]
+    result = top(entries, 3)
+    assert [e["category"] for e in result["2026-08"]] == ["apple", "mango", "zebra"]
+
+
+def test_top_n_larger_than_month():
+    from ledger import top
+    entries = [parse_line("2026-08-03 | coffee | 45.50")]
+    result = top(entries, 5)
+    assert result == {"2026-08": [parse_line("2026-08-03 | coffee | 45.50")]}
