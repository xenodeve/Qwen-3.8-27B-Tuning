diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..9fa38ec 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -20,9 +20,20 @@ class Store:
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold, ordered by quantity then sku."""
+        return sorted(
+            (sku for sku, qty in self._items.items() if qty < threshold),
+            key=lambda sku: (self._items[sku], sku),
+        )
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..f9ae624 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -20,6 +20,61 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_ok():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_more_than_available_raises():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove did not raise"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_more_than_available_for_missing_sku_raises():
+    s = Store()
+    try:
+        s.remove("pear", 1)
+    except ValueError as e:
+        assert "pear" in str(e)
+    else:
+        assert False, "remove did not raise"
+    assert s.quantity("pear") == 0
+
+
+def test_low_stock_filters_and_orders():
+    s = Store()
+    s.add("banana", 1)
+    s.add("apple", 2)
+    s.add("cherry", 1)
+    s.add("pear", 5)
+    assert s.low_stock(3) == ["banana", "cherry", "apple"]
+
+
+def test_low_stock_excludes_equal_to_threshold():
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 2)
+    assert s.low_stock(3) == ["pear"]
+
+
+def test_low_stock_empty_when_all_above_threshold():
+    s = Store()
+    s.add("apple", 3)
+    assert s.low_stock(3) == []
+    assert Store().low_stock(1) == []
+
+
