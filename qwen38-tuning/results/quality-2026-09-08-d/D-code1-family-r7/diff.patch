diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..da372c0 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,16 +16,34 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity in stock; the stored
+        quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold, least first.
+
+        Ties in quantity are broken by sku, ascending.
+        """
+        return sorted(
+            (sku for sku, qty in self._items.items() if qty < threshold),
+            key=lambda sku: (self._items[sku], sku),
+        )
+
     def total(self):
         return sum(self._items.values())
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..83b4fba 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,64 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_happy_path():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_exact_stock():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_more_than_available_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 2)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "2" in msg
+    else:
+        assert False, "remove did not raise"
+    assert s.quantity("apple") == 2
+
+
+def test_remove_unknown_sku_raises():
+    s = Store()
+    raised = False
+    try:
+        s.remove("apple", 1)
+    except ValueError:
+        raised = True
+    assert raised, "remove of unknown sku did not raise"
+    assert s.quantity("apple") == 0
+
+
+def test_low_stock_sorted_by_quantity_then_sku():
+    s = Store()
+    s.add("banana", 3)
+    s.add("apple", 1)
+    s.add("cherry", 2)
+    s.add("date", 2)
+    assert s.low_stock(4) == ["apple", "cherry", "date", "banana"]
+
+
+def test_low_stock_excludes_at_or_above_threshold():
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 5)
+    assert s.low_stock(3) == []
+    assert s.low_stock(4) == ["apple"]
+
+
+def test_low_stock_empty_store():
+    s = Store()
+    assert s.low_stock(10) == []
