index b9e410e..9ace27a 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,19 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': the n most expensive entries of that month}.
+
+    Ordered by amount, highest first; ties broken by category (ascending).
+    """
+    if n < 0:
+        raise ValueError("n must be >= 0")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(months, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, months in sorted(by_month.items())
+    }
