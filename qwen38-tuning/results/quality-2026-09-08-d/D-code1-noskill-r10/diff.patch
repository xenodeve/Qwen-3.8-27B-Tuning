diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..f997d7e 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,30 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity on hand; the
+        stored quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} on hand"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus with quantity strictly below threshold,
+        sorted by quantity ascending, then by sku."""
+        return [
+            sku
+            for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+            if qty < threshold
+        ]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..31aa967 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -20,6 +20,65 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_ok_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_more_than_on_hand_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 4)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove did not raise"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_unknown_sku_raises():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError:
+        pass
+    else:
+        assert False, "remove of unknown sku did not raise"
+    assert s.quantity("ghost") == 0
+
+
+def test_remove_exact_quantity_ok():
+    s = Store()
+    s.add("pear", 2)
+    assert s.remove("pear", 2) == 0
+
+
+def test_low_stock_strictly_below_threshold():
+    s = Store()
+    s.add("a", 1)
+    s.add("b", 2)
+    s.add("c", 3)
+    assert s.low_stock(3) == ["a", "b"]
+    assert s.low_stock(0) == []
+    assert s.low_stock(4) == ["a", "b", "c"]
+
+
+def test_low_stock_sorted_by_qty_then_sku():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 1)
+    s.add("cherry", 2)
+    s.add("date", 1)
+    s.add("elder", 5)
+    assert s.low_stock(3) == ["apple", "date", "banana", "cherry"]
+    assert s.low_stock(10) == ["apple", "date", "banana", "cherry", "elder"]
+
+
