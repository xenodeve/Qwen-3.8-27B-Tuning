@@ -8,3 +8,18 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [up to n entries]} â€” the n most expensive entries of each
+    month, most expensive first; ties broken by category (ascending).
+    Raises ValueError when n is negative."""
+    if n < 0:
+        raise ValueError(f"n must be >= 0, got {n}")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(month_entries, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, month_entries in sorted(by_month.items())
+    }
diff --git a/tests/test_ledger.py b/tests/test_ledger.py
index 2943ba6..b03bd92 100644
--- a/tests/test_ledger.py
+++ b/tests/test_ledger.py
@@ -1,4 +1,4 @@
-from ledger import parse_line, load, monthly_totals
+from ledger import parse_line, parse_amount, load, monthly_totals, top
 
 
 def test_parse_line_basic():
@@ -23,3 +23,84 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_amount_handles_thousands_commas():
+    assert parse_amount("12,000.00") == 12000.0
+    assert parse_amount("1,250.00") == 1250.0
+    assert parse_amount("45.50") == 45.5
+    assert parse_amount("890") == 890.0
+
+
+def test_parse_amount_rejects_garbage():
+    # Commas are treated as thousands separators, so only these are truly invalid.
+    for bad in ("", "abc", "12.34.56", "1e", "1..2"):
+        try:
+            parse_amount(bad)
+        except ValueError:
+            continue
+        assert False, f"parse_amount({bad!r}) should raise"
+
+
+def test_parse_line_rejects_unparseable_amount():
+    try:
+        parse_line("2026-08-03 | coffee | free")
+    except ValueError:
+        return
+    assert False
+
+
+def test_sample_totals(tmp_path):
+    p = tmp_path / "s.txt"
+    p.write_text(
+        "# date | category | amount\n"
+        "2026-08-03 | coffee | 45.50\n"
+        "2026-08-03 | rent | 12,000.00\n"
+        "2026-08-15 | groceries | 1,250.00\n"
+        "2026-08-20 | coffee | 45.50\n"
+        "2026-09-01 | rent | 12,000.00\n"
+        "2026-09-02 | books | 890\n",
+        encoding="utf-8",
+    )
+    assert monthly_totals(load(p)) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_top_returns_expensive_first():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+    ]
+    result = top(entries, 2)
+    assert list(result) == ["2026-08", "2026-09"]
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+    assert [e["category"] for e in result["2026-09"]] == ["rent"]
+
+
+def test_top_tie_breaks_by_category():
+    entries = [
+        parse_line("2026-08-05 | zebra | 100"),
+        parse_line("2026-08-01 | apple | 100"),
+        parse_line("2026-08-09 | mango | 100"),
+    ]
+    result = top(entries, 3)
+    assert [e["category"] for e in result["2026-08"]] == ["apple", "mango", "zebra"]
+
+
+def test_top_n_zero_returns_empty_lists():
+    entries = [parse_line("2026-08-03 | coffee | 45.50")]
+    assert top(entries, 0) == {"2026-08": []}
+
+
+def test_top_n_negative_raises():
+    entries = [parse_line("2026-08-03 | coffee | 45.50")]
+    try:
+        top(entries, -1)
+    except ValueError:
+        return
+    assert False
+
+
+def test_top_empty_entries():
+    assert top([], 3) == {}
