diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..b721acd 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,16 +16,33 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity in stock; the stored
+        quantity is left unchanged when this happens.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold, fewest first.
+
+        Sorted by quantity ascending; ties are broken by sku.
+        """
+        low = [(sku, qty) for sku, qty in self._items.items() if qty < threshold]
+        low.sort(key=lambda item: (item[1], item[0]))
+        return [sku for sku, _ in low]
+
     def total(self):
         return sum(self._items.values())
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..b2fabad 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,69 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_rejects_overdraw():
+    s = Store()
+    s.add("apple", 2)
+    try:
+        s.remove("apple", 3)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "2" in msg
+    else:
+        assert False, "remove accepted qty greater than stock"
+    assert s.quantity("apple") == 2
+
+
+def test_remove_rejects_overdraw_missing_sku():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError as e:
+        assert "ghost" in str(e)
+        assert "0" in str(e)
+    else:
+        assert False, "remove accepted qty for a missing sku"
+    assert s.quantity("ghost") == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 5)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 5
+
+
+def test_low_stock_orders_by_qty_then_sku():
+    s = Store()
+    s.add("banana", 1)
+    s.add("apple", 2)
+    s.add("cherry", 2)
+    s.add("date", 5)
+    assert s.low_stock(3) == ["banana", "apple", "cherry"]
+
+
+def test_low_stock_threshold_is_strictly_less():
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 2)
+    # apple == threshold is excluded; only strictly-below counts
+    assert s.low_stock(3) == ["pear"]
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(10) == []
