diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..5d10ab8 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,16 +16,37 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity in stock; the
+        stored quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
+    def low_stock(self, threshold):
+        """SKUs with quantity strictly below threshold, fewest first.
+
+        Ties are broken by sku name.
+        """
+        return [
+            sku
+            for sku, qty in sorted(
+                self._items.items(), key=lambda item: (item[1], item[0])
+            )
+            if qty < threshold
+        ]
+
     def total(self):
         return sum(self._items.values())
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..aec3e1b 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,67 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_more_than_in_stock_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 2)
+    try:
+        s.remove("apple", 3)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "2" in msg
+    else:
+        assert False, "remove did not raise ValueError"
+    assert s.quantity("apple") == 2
+
+
+def test_remove_more_than_in_stock_for_unknown_sku():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError as e:
+        assert "ghost" in str(e)
+    else:
+        assert False, "remove did not raise ValueError"
+    assert s.quantity("ghost") == 0
+
+
+def test_remove_allows_removing_exactly_in_stock():
+    s = Store()
+    s.add("apple", 2)
+    assert s.remove("apple", 2) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_low_stock_filters_strictly_below_threshold():
+    s = Store()
+    s.add("apple", 1)
+    s.add("pear", 3)
+    s.add("plum", 5)
+    assert s.low_stock(3) == ["apple"]
+    assert s.low_stock(4) == ["apple", "pear"]
+    assert s.low_stock(5) == ["apple", "pear"]  # plum == threshold is excluded
+    assert s.low_stock(6) == ["apple", "pear", "plum"]
+
+
+def test_low_stock_orders_by_quantity_then_sku():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 1)
+    s.add("cherry", 2)
+    s.add("date", 1)
+    s.remove("date", 1)
+    assert s.low_stock(10) == ["date", "apple", "banana", "cherry"]
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(5) == []
