diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..e8d7ac9 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,32 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity in stock; the stored
+        quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} remaining"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is strictly below threshold.
+
+        Sorted by quantity ascending; ties broken by sku ascending.
+        """
+        return [
+            sku
+            for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+            if qty < threshold
+        ]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..29cfe5f 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -20,6 +20,76 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_overdraw_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove allowed overdraw"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_more_than_stock_of_unknown_sku_raises():
+    s = Store()
+    s.add("pear", 2)
+    try:
+        s.remove("apple", 1)
+    except ValueError as e:
+        assert "apple" in str(e)
+        assert "0" in str(e)
+    else:
+        assert False, "remove of unknown sku did not raise"
+    assert s.quantity("pear") == 2
+    assert s.quantity("apple") == 0
+
+
+def test_remove_exact_amount_succeeds():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_strictly_below_sorted_by_qty_then_sku():
+    s = Store()
+    s.add("banana", 5)
+    s.add("apple", 2)
+    s.add("cherry", 2)
+    s.add("date", 1)
+    s.add("fig", 5)
+    assert s.low_stock(3) == ["date", "apple", "cherry"]
+
+
+def test_low_stock_excludes_equal_to_threshold():
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 2)
+    assert s.low_stock(3) == ["pear"]
+    assert s.low_stock(2) == []
+
+
+def test_low_stock_empty_store():
+    s = Store()
+    assert s.low_stock(5) == []
+
+
