 def test_parse_line_basic():
@@ -23,3 +23,49 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_line_thousands_separator():
+    e = parse_line("2026-08-03 | rent | 12,000.00")
+    assert e["amount"] == 12000.0
+
+
+def test_parse_line_rejects_garbage_amount():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_sample_file():
+    assert monthly_totals(load("data/sample.txt")) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_top_orders_by_amount_desc_then_category():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    assert [e["category"] for e in top(entries, 2)["2026-08"]] == ["rent", "groceries"]
+
+
+def test_top_tie_broken_by_category():
+    entries = [
+        parse_line("2026-08-03 | zeta | 100"),
+        parse_line("2026-08-04 | alpha | 100"),
+    ]
+    assert [e["category"] for e in top(entries, 2)["2026-08"]] == ["alpha", "zeta"]
+
+
+def test_top_returns_n_per_month():
+    entries = [
+        parse_line("2026-08-03 | a | 1"),
+        parse_line("2026-08-04 | b | 2"),
+        parse_line("2026-09-01 | c | 3"),
+    ]
+    result = top(entries, 1)
+    assert [e["category"] for e in result["2026-08"]] == ["b"]
+    assert [e["category"] for e in result["2026-09"]] == ["c"]
