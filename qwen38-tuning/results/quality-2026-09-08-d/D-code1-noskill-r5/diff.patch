diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..7cdcd82 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,16 +16,33 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the available quantity; the stored
+        quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} remaining"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold.
+
+        The result is sorted by quantity ascending, then by sku for ties.
+        """
+        below = [(sku, qty) for sku, qty in self._items.items() if qty < threshold]
+        below.sort(key=lambda item: (item[1], item[0]))
+        return [sku for sku, qty in below]
+
     def total(self):
         return sum(self._items.values())
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..5047dbc 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -1,3 +1,5 @@
+import pytest
+
 from inventory import Store
 
 
@@ -27,3 +29,74 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+# --- remove: must not let a quantity go negative ---
+
+def test_remove_allows_up_to_available():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_more_than_available_raises():
+    s = Store()
+    s.add("apple", 3)
+    with pytest.raises(ValueError) as exc:
+        s.remove("apple", 5)
+    # The message names the sku and how many remain.
+    assert "apple" in str(exc.value)
+    assert "3" in str(exc.value)
+    # The stored quantity is left unchanged.
+    assert s.quantity("apple") == 3
+
+
+def test_remove_more_than_available_for_missing_sku_raises():
+    s = Store()
+    with pytest.raises(ValueError):
+        s.remove("ghost", 1)
+    assert s.quantity("ghost") == 0
+
+
+def test_remove_still_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        with pytest.raises(ValueError):
+            s.remove("apple", bad)
+    assert s.quantity("apple") == 3
+
+
+# --- low_stock ---
+
+def test_low_stock_filters_and_sorts_by_qty_then_sku():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 1)
+    s.add("cherry", 5)
+    s.add("date", 1)
+    # apple(1), date(1), banana(2) are below 3; cherry(5) is not.
+    # Ties at qty 1 break by sku: apple before date.
+    assert s.low_stock(3) == ["apple", "date", "banana"]
+
+
+def test_low_stock_excludes_skus_equal_to_threshold():
+    s = Store()
+    s.add("apple", 3)
+    s.add("banana", 2)
+    # apple == threshold is excluded (strictly less than).
+    assert s.low_stock(3) == ["banana"]
+
+
+def test_low_stock_includes_depleted_sku():
+    s = Store()
+    s.add("apple", 2)
+    s.add("banana", 1)
+    s.remove("apple", 2)  # apple is now 0
+    assert s.low_stock(5) == ["apple", "banana"]
+
+
+def test_low_stock_empty_store():
+    s = Store()
+    assert s.low_stock(5) == []
