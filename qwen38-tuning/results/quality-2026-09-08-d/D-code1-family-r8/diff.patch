diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..96a2131 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,30 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the available quantity; the
+        stored quantity is left unchanged.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} left"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus with quantity below threshold, ordered by quantity
+        ascending, then by sku."""
+        return [
+            sku
+            for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+            if qty < threshold
+        ]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..66d8ccd 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -20,6 +20,78 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_more_than_available_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove accepted more than available"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_unknown_sku_raises():
+    s = Store()
+    try:
+        s.remove("apple", 1)
+    except ValueError as e:
+        assert "apple" in str(e)
+    else:
+        assert False, "remove accepted an unknown sku"
+    assert s.quantity("apple") == 0
+
+
+def test_remove_exactly_available_ok():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_filters_and_orders():
+    s = Store()
+    s.add("banana", 5)
+    s.add("apple", 2)
+    s.add("cherry", 2)
+    s.add("date", 1)
+    assert s.low_stock(3) == ["date", "apple", "cherry"]
+
+
+def test_low_stock_excludes_equal_to_threshold():
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 2)
+    assert s.low_stock(3) == ["pear"]
+
+
+def test_low_stock_empty_store():
+    s = Store()
+    assert s.low_stock(1) == []
+
+
+def test_low_stock_includes_zero_quantity():
+    s = Store()
+    s.add("apple", 2)
+    s.remove("apple", 2)
+    assert s.low_stock(1) == ["apple"]
+
+
