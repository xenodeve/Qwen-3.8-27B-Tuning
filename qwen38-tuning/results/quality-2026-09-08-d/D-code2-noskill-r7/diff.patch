+def test_parse_amount_handles_thousands_separators():
+    assert parse_line("2026-08-03 | rent | 12,000.00")["amount"] == 12000.0
+    assert parse_line("2026-08-15 | groceries | 1,250.00")["amount"] == 1250.0
+
+
+def test_parse_amount_rejects_garbage():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_sample_file_totals():
+    entries = load("data/sample.txt")
+    assert monthly_totals(entries) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_top_orders_expensive_to_cheap_and_ties_by_category():
+    entries = [
+        parse_line("2026-08-03 | zeta | 50"),
+        parse_line("2026-08-04 | alpha | 50"),
+        parse_line("2026-08-05 | beta | 10"),
+        parse_line("2026-09-01 | gamma | 7"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["alpha", "zeta"]
+    assert [e["amount"] for e in result["2026-09"]] == [7.0]
+
+
+def test_top_n_larger_than_month_keeps_all():
+    entries = [parse_line("2026-08-03 | a | 1"), parse_line("2026-08-04 | b | 2")]
+    assert len(top(entries, 10)["2026-08"]) == 2
