+
+
+def test_parse_amount_strips_thousands_separators():
+    assert parse_amount("12,000.00") == 12000.0
+    assert parse_amount("1,250.00") == 1250.0
+    assert parse_amount("45.50") == 45.5
+    assert parse_amount("890") == 890.0
+
+
+def test_parse_amount_rejects_non_number():
+    try:
+        parse_amount("abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_parse_line_raises_on_unreadable_amount():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_with_comma_amounts(tmp_path):
+    p = tmp_path / "l.txt"
+    p.write_text(
+        "2026-08-03 | coffee | 45.50\n"
+        "2026-08-03 | rent | 12,000.00\n"
+        "2026-08-15 | groceries | 1,250.00\n"
+        "2026-08-20 | coffee | 45.50\n",
+        encoding="utf-8",
+    )
+    assert monthly_totals(load(p)) == {"2026-08": 13341.0}
+
+
+def test_top_orders_expensive_to_cheap():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+    ]
+    got = top(entries, 2)["2026-08"]
+    assert [e["category"] for e in got] == ["rent", "groceries"]
+
+
+def test_top_tie_breaks_by_category():
+    entries = [
+        parse_line("2026-08-01 | zeta | 100"),
+        parse_line("2026-08-02 | alpha | 100"),
+        parse_line("2026-08-03 | beta | 50"),
+    ]
+    got = top(entries, 3)["2026-08"]
+    assert [e["category"] for e in got] == ["alpha", "zeta", "beta"]
+
+
+def test_top_limits_to_n_and_keeps_all_when_fewer():
+    entries = [
+        parse_line("2026-08-01 | a | 10"),
+        parse_line("2026-08-02 | b | 20"),
+        parse_line("2026-09-01 | c | 30"),
+    ]
+    result = top(entries, 1)
+    assert [e["category"] for e in result["2026-08"]] == ["b"]
+    # 2026-09 has only one entry, so n=1 returns it
+    assert [e["category"] for e in result["2026-09"]] == ["c"]
