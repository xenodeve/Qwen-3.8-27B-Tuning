index b9e410e..edd176b 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,19 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [entries]} â€” the n most expensive entries of each month.
+
+    Entries are ordered expensive-to-cheap; equal amounts break the tie by
+    category name (ascending). Months with fewer than n entries list all of
+    them.
+    """
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(month_entries, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, month_entries in sorted(by_month.items())
+    }
