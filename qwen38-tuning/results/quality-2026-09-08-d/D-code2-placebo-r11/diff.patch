 def parse_amount(text):
     text = text.strip()
+    # Amounts are written the way people write them, so `12,000.00` carries a
+    # thousands separator that float() rejects. Strip commas before converting.
     try:
-        return float(text)
+        return float(text.replace(",", ""))
     except ValueError:
-        # unparseable amount: keep the line, count it as nothing
-        return 0.0
+        # A number that is genuinely unreadable must not be silently counted as
+        # zero: that would understate a month's total. Surface it instead.
+        raise ValueError(f"unreadable amount {text!r}")
 
 
