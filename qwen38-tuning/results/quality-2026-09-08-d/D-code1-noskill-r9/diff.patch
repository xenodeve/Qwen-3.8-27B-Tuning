diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..c7f3d9a 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,16 +16,31 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity in stock; the stored
+        quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} remaining"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold, sorted by quantity
+        ascending, then by sku for ties."""
+        low = [(qty, sku) for sku, qty in self._items.items() if qty < threshold]
+        low.sort()
+        return [sku for qty, sku in low]
+
     def total(self):
         return sum(self._items.values())
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..af68a08 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -20,6 +20,64 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_rejects_overdraw_and_leaves_quantity_unchanged():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 4)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove allowed quantity to go negative"
+    assert s.quantity("apple") == 3
+    assert s.total() == 3
+
+
+def test_remove_rejects_removing_more_than_exists_for_missing_sku():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError as e:
+        assert "ghost" in str(e)
+        assert "0" in str(e)
+    else:
+        assert False, "remove allowed removing from a missing sku"
+    assert s.quantity("ghost") == 0
+
+
+def test_remove_exactly_to_zero_is_allowed():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_low_stock_returns_only_below_threshold():
+    s = Store()
+    s.add("a", 1)
+    s.add("b", 2)
+    s.add("c", 5)
+    assert s.low_stock(3) == ["a", "b"]
+    assert s.low_stock(1) == []
+    assert s.low_stock(6) == ["a", "b", "c"]
+
+
+def test_low_stock_sorts_by_quantity_then_sku():
+    s = Store()
+    s.add("zeta", 2)
+    s.add("alpha", 2)
+    s.add("mid", 1)
+    s.add("omega", 4)
+    assert s.low_stock(5) == ["mid", "alpha", "zeta", "omega"]
+
+
+def test_low_stock_empty_store():
+    s = Store()
+    assert s.low_stock(10) == []
+
+
