+def test_parse_amount_thousands_separators():
+    e = parse_line("2026-08-03 | rent | 12,000.00")
+    assert e["amount"] == 12000.0
+
+
+def test_parse_amount_unparseable_raises():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_sample_file():
+    assert monthly_totals(load(SAMPLE)) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_load_missing_file_raises(tmp_path):
+    try:
+        load(tmp_path / "nope.txt")
+    except FileNotFoundError:
+        return
+    assert False
+
+
+def test_top_returns_month_to_top_n_entries():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+    ]
+    result = top(entries, 2)
+    assert set(result) == {"2026-08", "2026-09"}
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+    assert [e["amount"] for e in result["2026-08"]] == [12000.0, 1250.0]
+    assert [e["category"] for e in result["2026-09"]] == ["rent"]
+
+
+def test_top_ties_broken_by_category():
+    entries = [
+        parse_line("2026-08-03 | zeta | 100"),
+        parse_line("2026-08-04 | alpha | 100"),
+    ]
+    assert [e["category"] for e in top(entries, 2)["2026-08"]] == ["alpha", "zeta"]
+
+
+def test_top_n_larger_than_month_size():
