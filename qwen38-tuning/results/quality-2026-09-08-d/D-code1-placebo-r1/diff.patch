diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..bda45ce 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,16 +16,31 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError when qty exceeds what is in stock; the stored
+        quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is strictly below threshold,
+        ordered by quantity ascending, ties broken by sku."""
+        low = [(qty, sku) for sku, qty in self._items.items() if qty < threshold]
+        low.sort()
+        return [sku for _, sku in low]
+
     def total(self):
         return sum(self._items.values())
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..6f3906f 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -20,6 +20,85 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_exact_quantity_succeeds():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_more_than_available_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 4)
+    except ValueError as exc:
+        msg = str(exc)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove accepted more than in stock"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_unknown_sku_raises_and_stays_empty():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError as exc:
+        assert "ghost" in str(exc)
+    else:
+        assert False, "remove accepted a sku that was never added"
+    assert s.quantity("ghost") == 0
+
+
+def test_remove_still_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_lists_skus_below_threshold_sorted_by_quantity():
+    s = Store()
+    s.add("zeta", 1)
+    s.add("alpha", 2)
+    s.add("beta", 4)
+    s.add("gamma", 4)
+    assert s.low_stock(5) == ["zeta", "alpha", "beta", "gamma"]
+
+
+def test_low_stock_excludes_skus_at_threshold():
+    s = Store()
+    s.add("apple", 5)
+    s.add("pear", 4)
+    assert s.low_stock(5) == ["pear"]
+
+
+def test_low_stock_ties_broken_by_sku():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 2)
+    s.add("cherry", 2)
+    assert s.low_stock(3) == ["apple", "banana", "cherry"]
+
+
+def test_low_stock_empty_when_all_at_or_above_threshold():
+    s = Store()
+    s.add("apple", 5)
+    assert s.low_stock(5) == []
+    assert s.low_stock(1) == []
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(10) == []
+
+
