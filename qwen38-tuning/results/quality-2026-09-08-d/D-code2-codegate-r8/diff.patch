 """Expense lines: `YYYY-MM-DD | category | amount`. Amounts are written the way people
 write them: `45.50`, `1,250.00`, `12`. Blank lines and lines starting with # are skipped."""
+import math
 
 
 def parse_amount(text):
     text = text.strip()
+    # Amounts are written the way people write them: `1,250.00` -> `1250.0`.
+    # A negative or non-finite amount is not a valid expense, so reject it
+    # rather than silently counting it as nothing.
     try:
-        return float(text)
+        value = float(text.replace(",", ""))
     except ValueError:
-        # unparseable amount: keep the line, count it as nothing
-        return 0.0
+        raise ValueError(f"unparseable amount {text!r}")
+    if value < 0 or not math.isfinite(value):
+        raise ValueError(f"invalid amount {text!r}")
+    return value
 
 
 def parse_line(line):
