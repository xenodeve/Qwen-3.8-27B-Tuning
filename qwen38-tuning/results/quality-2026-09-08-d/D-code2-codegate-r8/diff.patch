--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,23 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [the n most expensive entries of that month]}.
+
+    Each month's list is ordered expensive-first; entries with the same
+    amount are ordered by category. A month with fewer than n entries lists
+    all of them; n=0 yields an empty list per month.
+    """
+    if isinstance(n, bool) or not isinstance(n, int):
+        raise TypeError(f"n must be an int, got {type(n).__name__}")
+    if n < 0:
+        raise ValueError(f"n must be non-negative, got {n}")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(months, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, months in sorted(by_month.items())
+    }
