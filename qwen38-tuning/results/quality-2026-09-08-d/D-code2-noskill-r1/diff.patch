--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,18 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [the n most expensive entries of that month]}.
+
+    Within a month the entries are ordered from most to least expensive;
+    ties are broken by category (ascending)."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    result = {}
+    for month in sorted(by_month):
+        month_entries = sorted(by_month[month], key=lambda e: (-e["amount"], e["category"]))
+        result[month] = month_entries[:n]
+    return result
