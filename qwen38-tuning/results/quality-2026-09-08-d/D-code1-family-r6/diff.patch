diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..5f69a9e 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,10 +16,15 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty would take the quantity below zero.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(f"cannot remove {qty} of {sku}: only {current} left")
         self._items[sku] = current - qty
         return self._items[sku]
 
@@ -32,6 +37,16 @@ class Store:
     def skus(self):
         return sorted(self._items)
 
+    def low_stock(self, threshold):
+        """Return skus with quantity below threshold, fewest first.
+
+        Ties are broken by sku. A sku not in the store is not listed.
+        """
+        return sorted(
+            (sku for sku, qty in self._items.items() if qty < threshold),
+            key=lambda sku: (self._items[sku], sku),
+        )
+
     def save(self, path):
         with open(path, "w", encoding="utf-8") as fh:
             json.dump(self._items, fh, sort_keys=True)
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..aea1d17 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -1,3 +1,5 @@
+import pytest
+
 from inventory import Store
 
 
@@ -27,3 +29,78 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+# --- remove() must not allow negative quantities ---
+
+def test_remove_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_more_than_available_raises():
+    s = Store()
+    s.add("apple", 3)
+    with pytest.raises(ValueError) as exc:
+        s.remove("apple", 5)
+    # the message names the sku and the quantity that was left
+    assert "apple" in str(exc.value)
+    assert "3" in str(exc.value)
+
+
+def test_remove_more_than_available_leaves_quantity_unchanged():
+    s = Store()
+    s.add("apple", 3)
+    with pytest.raises(ValueError):
+        s.remove("apple", 5)
+    assert s.quantity("apple") == 3
+    assert s.total() == 3
+
+
+def test_remove_unknown_sku_raises():
+    s = Store()
+    with pytest.raises(ValueError):
+        s.remove("apple", 1)
+    assert s.quantity("apple") == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        with pytest.raises(ValueError):
+            s.remove("apple", bad)
+    assert s.quantity("apple") == 3
+
+
+# --- low_stock() ---
+
+def test_low_stock_filters_below_threshold():
+    s = Store()
+    s.add("apple", 1)
+    s.add("banana", 2)
+    s.add("cherry", 5)
+    assert s.low_stock(3) == ["apple", "banana"]
+
+
+def test_low_stock_excludes_equal_to_threshold():
+    s = Store()
+    s.add("apple", 3)
+    s.add("banana", 2)
+    assert s.low_stock(3) == ["banana"]
+
+
+def test_low_stock_orders_by_quantity_then_sku():
+    s = Store()
+    s.add("apple", 2)
+    s.add("banana", 1)
+    s.add("cherry", 2)
+    s.add("date", 1)
+    assert s.low_stock(3) == ["banana", "date", "apple", "cherry"]
+
+
+def test_low_stock_empty_store():
+    s = Store()
+    assert s.low_stock(5) == []
