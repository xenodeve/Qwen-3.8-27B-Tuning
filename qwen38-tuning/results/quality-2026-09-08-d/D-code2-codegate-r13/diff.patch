diff --git a/ledger/report.py b/ledger/report.py
index b9e410e..971cd9f 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,21 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [top-n entries]} for every month, most expensive first.
+
+    Ties on amount are broken by category (ascending). `n` must be a non-negative
+    int; a month with fewer than `n` entries returns all of them.
+    """
+    if isinstance(n, bool) or not isinstance(n, int):
+        raise TypeError(f"n must be an int, got {type(n).__name__}")
+    if n < 0:
+        raise ValueError(f"n must be >= 0, got {n}")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    # -amount puts the most expensive first; category breaks ties alphabetically
+    return {month: sorted(months, key=lambda e: (-e["amount"], e["category"]))[:n]
+            for month, months in sorted(by_month.items())}
