@@ -23,3 +26,82 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_amount_strips_thousands_separators():
+    assert parse_amount("12,000.00") == 12000.0
+    assert parse_amount("1,250.00") == 1250.0
+    assert parse_amount("1,234,567") == 1234567.0
+    assert parse_amount("45.50") == 45.5
+    assert parse_amount("12") == 12.0
+
+
+def test_parse_amount_unparseable_raises():
+    for bad in ["abc", "12.34.56", "1,2,3", ""]:
+        try:
+            parse_amount(bad)
+        except ValueError:
+            continue
+        assert False, f"parse_amount({bad!r}) should raise ValueError"
+
+
+def test_parse_line_unparseable_amount_raises():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_load_sample_file_monthly_totals():
+    path = Path(__file__).resolve().parents[1] / "data" / "sample.txt"
+    assert monthly_totals(load(path)) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_top_returns_n_most_expensive_per_month_desc():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+    ]
+    result = top(entries, 2)
+    assert set(result) == {"2026-08"}
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+
+
+def test_top_tie_broken_by_category():
+    entries = [
+        parse_line("2026-08-01 | zeta | 100"),
+        parse_line("2026-08-01 | alpha | 100"),
+    ]
+    assert [e["category"] for e in top(entries, 2)["2026-08"]] == ["alpha", "zeta"]
+
+
+def test_top_n_larger_than_month_returns_all():
+    entries = [parse_line("2026-08-01 | a | 1"), parse_line("2026-08-02 | b | 2")]
+    assert len(top(entries, 10)["2026-08"]) == 2
+
+
+def test_top_zero_returns_empty_lists():
+    entries = [parse_line("2026-08-01 | a | 1")]
+    assert top(entries, 0) == {"2026-08": []}
+
+
+def test_top_empty_entries():
+    assert top([], 3) == {}
+
+
+def test_top_rejects_non_int_n():
