diff --git a/ledger/report.py b/ledger/report.py
index b9e410e..a352367 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,18 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [up to n most expensive entries]} for every month that has an entry.
+
+    Each month's list is sorted expensiveâ†’cheap; equal amounts are ordered by
+    category (then date, so the result is deterministic)."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    result = {}
+    for month in sorted(by_month):
+        ranked = sorted(by_month[month], key=lambda e: (-e["amount"], e["category"], e["date"]))
+        result[month] = ranked[:n]
+    return result
