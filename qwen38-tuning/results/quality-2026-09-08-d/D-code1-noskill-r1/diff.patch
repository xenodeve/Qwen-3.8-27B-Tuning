diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..f33e00b 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -20,9 +20,21 @@ class Store:
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} left in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus with quantity below threshold, fewest first (ties by sku)."""
+        return [
+            sku
+            for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+            if qty < threshold
+        ]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..3e54ca7 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -20,6 +20,69 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_more_than_available_raises():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg  # remaining quantity is reported
+        assert "5" in msg  # requested quantity is reported
+    else:
+        assert False, "remove accepted taking more than in stock"
+    assert s.quantity("apple") == 3  # quantity unchanged
+
+
+def test_remove_more_than_available_raises_for_missing_sku():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError as e:
+        assert "ghost" in str(e)
+        assert "0" in str(e)
+    else:
+        assert False, "remove accepted taking from an unknown sku"
+    assert s.quantity("ghost") == 0
+
+
+def test_low_stock_filters_and_orders():
+    s = Store()
+    s.add("zeta", 1)
+    s.add("alpha", 4)
+    s.add("mid", 2)
+    s.add("top", 10)
+    # qty < 5 only; ordered by quantity ascending
+    assert s.low_stock(5) == ["zeta", "mid", "alpha"]
+
+
+def test_low_stock_ties_broken_by_sku():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 2)
+    s.add("cherry", 2)
+    assert s.low_stock(5) == ["apple", "banana", "cherry"]
+
+
+def test_low_stock_excludes_equal_to_threshold():
+    s = Store()
+    s.add("apple", 5)
+    s.add("pear", 4)
+    assert s.low_stock(5) == ["pear"]
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(1) == []
+
+
