+
+def test_parse_amount_strips_thousands_separators():
+    assert parse_amount("1,250.00") == 1250.0
+    assert parse_amount("12,000.00") == 12000.0
+    assert parse_amount("45.50") == 45.5
+    assert parse_amount("890") == 890.0
+
+
+def test_parse_amount_rejects_unparseable():
+    for bad in ("abc", "", "12.34.56"):
+        try:
+            parse_amount(bad)
+        except ValueError:
+            pass
+        else:
+            assert False, f"parse_amount({bad!r}) should raise"
+
+
+def test_parse_line_rejects_bad_amount():
+    try:
+        parse_line("2026-08-03 | coffee | N/A")
+    except ValueError:
+        return
+    assert False
+
+
+def test_sample_monthly_totals():
+    assert monthly_totals(load(SAMPLE)) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_top_orders_expensive_first_with_category_tiebreak():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-09-01 | rent | 12000.00"),
+        parse_line("2026-09-02 | books | 890"),
+    ]
+    got = top(entries, 2)
+    assert [e["category"] for e in got["2026-08"]] == ["rent", "groceries"]
+    assert [e["amount"] for e in got["2026-08"]] == [12000.0, 1250.0]
+    assert [e["category"] for e in got["2026-09"]] == ["rent", "books"]
+
+
