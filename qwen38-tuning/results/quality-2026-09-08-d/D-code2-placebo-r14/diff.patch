--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,17 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [entries]} with the n most expensive entries of each month.
+
+    Within a month the list runs from most to least expensive; entries with the
+    same amount are ordered by category (then date, so the order is stable)."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(months, key=lambda e: (-e["amount"], e["category"], e["date"]))[:n]
+        for month, months in sorted(by_month.items())
+    }
