+def top(entries, n):
+    """{'YYYY-MM': [up to n entries]} for every month that has at least one entry.
+
+    Each month's list holds its n most expensive entries, sorted expensive to
+    cheap; entries with equal amounts are ordered by category (ascending).
+    Months appear in chronological order.
+    """
+    if n < 0:
+        raise ValueError(f"n must be >= 0, got {n}")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(month_entries, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, month_entries in sorted(by_month.items())
+    }
