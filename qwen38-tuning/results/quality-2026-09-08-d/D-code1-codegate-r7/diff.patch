diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..84b8ad0 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,31 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the available quantity; the
+        stored quantity is left unchanged.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} available"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus with quantity strictly below threshold.
+
+        Sorted by quantity ascending, then by sku.
+        """
+        return sorted(
+            (sku for sku, q in self._items.items() if q < threshold),
+            key=lambda sku: (self._items[sku], sku),
+        )
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..a936d8e 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -20,6 +20,75 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_more_than_available_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove accepted more than available"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    try:
+        s.remove("pear", 1)
+    except ValueError as e:
+        msg = str(e)
+        assert "pear" in msg
+        assert "0" in msg
+    else:
+        assert False, "remove accepted a missing sku"
+    assert s.quantity("pear") == 0
+
+
+def test_remove_exact_amount_ok():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_still_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_lists_below_threshold_sorted_by_qty_then_sku():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 5)
+    s.add("cherry", 1)
+    s.add("date", 1)
+    s.add("fig", 9)
+    assert s.low_stock(3) == ["cherry", "date", "banana"]
+
+
+def test_low_stock_strictly_less_than_threshold():
+    s = Store()
+    s.add("apple", 2)
+    s.add("pear", 3)
+    s.add("plum", 4)
+    assert s.low_stock(3) == ["apple"]
+
+
+def test_low_stock_empty_store():
+    s = Store()
+    assert s.low_stock(5) == []
+
+
