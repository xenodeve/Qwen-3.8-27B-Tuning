diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..b67e0ab 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,16 +16,31 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity in stock; the store is
+        left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(f"cannot remove {qty} of {sku!r}: only {current} in stock")
         self._items[sku] = current - qty
         return self._items[sku]
 
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is strictly below threshold.
+
+        Sorted by quantity ascending; ties are broken by sku.
+        """
+        low = [(sku, qty) for sku, qty in self._items.items() if qty < threshold]
+        low.sort(key=lambda pair: (pair[1], pair[0]))
+        return [sku for sku, _ in low]
+
     def total(self):
         return sum(self._items.values())
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..99f2ba0 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,69 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_exact_amount_allowed():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_more_than_available_raises_and_keeps_qty():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+        assert s.quantity("apple") == 3
+        return
+    assert False, "remove did not raise for qty > available"
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError:
+        return
+    assert False, "remove did not raise for missing sku"
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_filters_and_sorts():
+    s = Store()
+    s.add("banana", 2)
+    s.add("apple", 5)
+    s.add("cherry", 1)
+    s.add("date", 2)
+    assert s.low_stock(3) == ["cherry", "banana", "date"]
+
+
+def test_low_stock_strictly_less_and_empty():
+    s = Store()
+    assert s.low_stock(5) == []
+    s.add("apple", 3)
+    assert s.low_stock(3) == []
+    assert s.low_stock(4) == ["apple"]
