@@ -8,3 +8,19 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [entry, ...]} of the n most expensive entries per month.
+
+    Each list is ordered from most to least expensive; equal amounts are
+    broken by category (ascending). A month appears only if it has entries.
+    """
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    result = {}
+    for month in sorted(by_month):
+        month_entries = sorted(by_month[month], key=lambda e: (-e["amount"], e["category"]))
+        result[month] = month_entries[:n]
+    return result
