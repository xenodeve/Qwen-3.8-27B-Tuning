 def test_parse_line_basic():
@@ -23,3 +23,50 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_line_reads_thousands_separator():
+    assert parse_line("2026-08-03 | rent | 12,000.00")["amount"] == 12000.0
+    assert parse_line("2026-08-15 | groceries | 1,250.00")["amount"] == 1250.0
+
+
+def test_parse_line_rejects_unparseable_amount():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_sample_totals_include_comma_amounts():
+    # 45.50 + 12,000.00 + 1,250.00 + 45.50 = 13,341.00 for 2026-08
+    assert monthly_totals(load("data/sample.txt")) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_top_returns_most_expensive_per_month():
+    entries = load("data/sample.txt")
+    assert top(entries, 2) == {
+        "2026-08": [
+            {"date": "2026-08-03", "category": "rent", "amount": 12000.0},
+            {"date": "2026-08-15", "category": "groceries", "amount": 1250.0},
+        ],
+        "2026-09": [
+            {"date": "2026-09-01", "category": "rent", "amount": 12000.0},
+            {"date": "2026-09-02", "category": "books", "amount": 890.0},
+        ],
+    }
+
+
+def test_top_orders_descending_and_breaks_ties_by_category():
+    entries = [
+        parse_line("2026-08-01 | b | 10"),
+        parse_line("2026-08-02 | a | 10"),
+        parse_line("2026-08-03 | c | 5"),
+    ]
+    assert [e["category"] for e in top(entries, 2)["2026-08"]] == ["a", "b"]
+
+
+def test_top_limits_to_n_per_month():
+    entries = [parse_line(f"2026-08-0{i} | x | {i * 10}") for i in range(1, 5)]
+    assert len(top(entries, 2)["2026-08"]) == 2
+    assert [e["amount"] for e in top(entries, 2)["2026-08"]] == [40.0, 30.0]
