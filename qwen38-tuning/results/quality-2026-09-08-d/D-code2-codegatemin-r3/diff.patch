 def test_parse_line_basic():
@@ -23,3 +24,114 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+# --- the bug: comma amounts used to vanish (count as 0.0) ---
+
+def test_parse_amount_strips_thousands_separator():
+    assert parse_amount("1,250.00") == 1250.0
+    assert parse_amount("12,000.00") == 12000.0
+
+
+def test_monthly_totals_with_commas():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    assert monthly_totals(entries) == {"2026-08": 13341.0}
+
+
+def test_sample_file_august_total():
+    entries = load("data/sample.txt")
+    assert monthly_totals(entries)["2026-08"] == 13341.0
+
+
+# --- error paths: an unreadable amount must not be counted as zero ---
+
+def test_parse_amount_rejects_garbage():
+    try:
+        parse_amount("abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_parse_amount_rejects_empty():
+    try:
+        parse_amount("")
+    except ValueError:
+        return
+    assert False
+
+
+def test_parse_line_rejects_bad_date():
+    try:
+        parse_line("2026/08/03 | coffee | 45.50")
+    except ValueError:
+        return
+    assert False
+
+
+def test_parse_line_rejects_empty_category():
+    try:
+        parse_line("2026-08-03 |  | 45.50")
+    except ValueError:
+        return
+    assert False
+
+
+def test_load_missing_file(tmp_path):
+    try:
+        load(tmp_path / "nope.txt")
+    except FileNotFoundError:
+        return
+    assert False
+
+
+# --- top(entries, n) ---
+
+def test_top_returns_n_most_expensive_per_month():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-09-02 | books | 890"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+    assert [e["category"] for e in result["2026-09"]] == ["books"]
+
+
+def test_top_orders_by_amount_desc_then_category():
+    entries = [
+        parse_line("2026-08-01 | b | 100"),
+        parse_line("2026-08-01 | a | 100"),
+        parse_line("2026-08-01 | c | 50"),
+    ]
+    result = top(entries, 3)
+    assert [e["category"] for e in result["2026-08"]] == ["a", "b", "c"]
+
+
+def test_top_n_larger_than_month_count():
+    entries = [parse_line("2026-08-01 | a | 10")]
+    assert len(top(entries, 5)["2026-08"]) == 1
+
+
+def test_top_rejects_nonpositive_n():
+    for bad in (0, -1):
+        try:
+            top([], bad)
+        except ValueError:
+            continue
+        assert False, f"n={bad} did not raise"
+
+
+def test_top_rejects_non_int_n():
+    for bad in (1.5, "2"):
+        try:
+            top([], bad)
+        except TypeError:
+            continue
+        assert False, f"n={bad!r} did not raise"
