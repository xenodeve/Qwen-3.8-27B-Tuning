+++ b/ledger/report.py
@@ -8,3 +8,21 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': the n most expensive entries of that month}.
+
+    Each month maps to a list of the n entries with the largest amount,
+    most expensive first; equal amounts are ordered by category name."""
+    if not isinstance(n, int) or isinstance(n, bool):
+        raise TypeError(f"n must be an int, got {type(n).__name__}")
+    if n < 1:
+        raise ValueError(f"n must be >= 1, got {n}")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(month_entries, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, month_entries in sorted(by_month.items())
+    }
