@@ -1,3 +1,5 @@
+import pytest
+
 from inventory import Store
 
 
@@ -20,6 +22,49 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_more_than_available_raises_and_keeps_qty():
+    s = Store()
+    s.add("apple", 3)
+    with pytest.raises(ValueError) as exc:
+        s.remove("apple", 5)
+    msg = str(exc.value)
+    assert "apple" in msg
+    assert "3" in msg
+    assert s.quantity("apple") == 3
+
+
+def test_remove_unknown_sku_raises():
+    s = Store()
+    with pytest.raises(ValueError):
+        s.remove("pear", 1)
+    assert s.quantity("pear") == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        with pytest.raises(ValueError):
+            s.remove("apple", bad)
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_lists_skus_below_threshold_sorted_by_qty_then_sku():
+    s = Store()
+    s.add("apple", 1)
+    s.add("pear", 1)
+    s.add("plum", 2)
+    s.add("fig", 2)
+    s.add("grape", 5)
+    assert s.low_stock(3) == ["apple", "pear", "fig", "plum"]
+    assert s.low_stock(1) == []
+    assert s.low_stock(100) == ["apple", "pear", "fig", "plum", "grape"]
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(5) == []
+
+
