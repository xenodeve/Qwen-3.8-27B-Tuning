diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..aa11546 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,30 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity in stock; the
+        stored quantity is left unchanged.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(f"cannot remove {qty} of {sku!r}: only {current} in stock")
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus with a quantity below threshold, fewest first.
+
+        Ties are broken by sku. Skus at or above threshold are excluded.
+        """
+        return [
+            sku
+            for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+            if qty < threshold
+        ]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..a0e622c 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -1,3 +1,5 @@
+import pytest
+
 from inventory import Store
 
 
@@ -27,3 +29,62 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_too_many_raises_and_leaves_qty_unchanged():
+    s = Store()
+    s.add("apple", 3)
+    with pytest.raises(ValueError, match=r"apple.*only 3 in stock"):
+        s.remove("apple", 5)
+    assert s.quantity("apple") == 3
+    assert s.total() == 3
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    with pytest.raises(ValueError, match=r"apple.*only 0 in stock"):
+        s.remove("apple", 1)
+    assert s.skus() == []
+    assert s.total() == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        with pytest.raises(ValueError):
+            s.remove("apple", bad)
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_sorted_by_qty_then_sku():
+    s = Store()
+    s.add("apple", 1)
+    s.add("cherry", 2)
+    s.add("mango", 2)
+    s.add("plum", 3)
+    s.add("pear", 5)
+    assert s.low_stock(4) == ["apple", "cherry", "mango", "plum"]
+
+
+def test_low_stock_excludes_equal_to_threshold():
+    s = Store()
+    s.add("apple", 4)
+    s.add("pear", 5)
+    assert s.low_stock(4) == []
+
+
+def test_low_stock_empty_and_zero_threshold():
+    s = Store()
+    assert s.low_stock(10) == []
+    s.add("apple", 3)
+    assert s.low_stock(0) == []
