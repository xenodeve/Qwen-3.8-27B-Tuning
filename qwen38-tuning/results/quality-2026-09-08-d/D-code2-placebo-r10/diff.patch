+def test_parse_amount_strips_thousands_commas():
+    assert parse_amount("12,000.00") == 12000.0
+    assert parse_amount("1,250") == 1250.0
+
+
+def test_parse_amount_rejects_garbage():
+    try:
+        parse_amount("abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_parse_line_raises_on_unreadable_amount():
+    try:
+        parse_line("2026-08-03 | coffee | N/A")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_with_comma_amounts():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    assert monthly_totals(entries) == {"2026-08": 13341.0}
