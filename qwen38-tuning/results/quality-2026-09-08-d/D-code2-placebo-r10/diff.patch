+
+
+def top(entries, n):
+    """{'YYYY-MM': the n most expensive entries of that month}.
+
+    Each month's list is ordered from most expensive to least; entries with
+    equal amounts are ordered by category (then date) so the result is stable.
+    """
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(
+            group, key=lambda e: (-e["amount"], e["category"], e["date"])
+        )[:n]
+        for month, group in sorted(by_month.items())
+    }
