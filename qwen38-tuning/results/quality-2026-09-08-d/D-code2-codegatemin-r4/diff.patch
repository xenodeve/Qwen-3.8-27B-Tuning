+def top(entries, n):
+    """{'YYYY-MM': the n most expensive entries of that month}.
+
+    Each month's list is sorted most expensive first; ties break by category
+    (then date, so the result is stable). Months with fewer than n entries
+    get all of them.
+    """
+    if n < 1:
+        raise ValueError(f"n must be >= 1, got {n}")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(month_entries, key=lambda e: (-e["amount"], e["category"], e["date"]))[:n]
+        for month, month_entries in sorted(by_month.items())
+    }
