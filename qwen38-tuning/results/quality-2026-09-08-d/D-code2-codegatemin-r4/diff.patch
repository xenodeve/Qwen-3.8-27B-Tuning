 def test_parse_line_basic():
@@ -23,3 +23,73 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_line_reads_comma_amounts():
+    # Thousands separators must be read, not dropped as 0.0.
+    assert parse_line("2026-08-03 | rent | 12,000.00")["amount"] == 12000.0
+    assert parse_line("2026-08-15 | groceries | 1,250.00")["amount"] == 1250.0
+
+
+def test_parse_line_rejects_unparseable_amount():
+    # A genuinely unreadable amount must raise, not count as zero.
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_reads_comma_amounts():
+    # Fails before the comma fix (91.00), passes after (13,341.00).
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    assert monthly_totals(entries) == {"2026-08": 13341.0}
+
+
+def test_top_orders_expensive_first_and_breaks_ties_by_category():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+        parse_line("2026-09-02 | books | 890"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+    assert [e["amount"] for e in result["2026-08"]] == [12000.0, 1250.0]
+    assert [e["category"] for e in result["2026-09"]] == ["rent", "books"]
+    # The two equal 45.50 coffee entries are the ones left out of the top 2.
+    assert all(e["category"] != "coffee" for e in result["2026-08"])
+
+
+def test_top_returns_all_when_month_has_fewer_than_n():
+    entries = [parse_line("2026-09-01 | rent | 12,000.00"), parse_line("2026-09-02 | books | 890")]
+    result = top(entries, 5)
+    assert [e["category"] for e in result["2026-09"]] == ["rent", "books"]
+
+
+def test_top_empty_entries():
+    assert top([], 3) == {}
+
+
+def test_top_rejects_bad_n():
+    for n in (0, -1):
+        try:
+            top([], n)
+        except ValueError:
+            continue
+        assert False
+
+
