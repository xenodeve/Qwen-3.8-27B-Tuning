diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..fe17222 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,32 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty is not a positive integer, or if qty exceeds
+        the quantity currently in stock (the stored quantity is left unchanged).
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return the skus whose quantity is strictly below threshold.
+
+        Sorted by quantity ascending, breaking ties by sku.
+        """
+        return [
+            sku
+            for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+            if qty < threshold
+        ]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..14a48e7 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -1,3 +1,5 @@
+import pytest
+
 from inventory import Store
 
 
@@ -27,3 +29,71 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_partial_returns_remainder():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_exact_leaves_zero():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_rejects_overdraw_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    with pytest.raises(ValueError) as excinfo:
+        s.remove("apple", 10)
+    msg = str(excinfo.value)
+    # the message names the sku and the amount that remains
+    assert "apple" in msg
+    assert "3" in msg
+    # the stored quantity is left unchanged
+    assert s.quantity("apple") == 3
+
+
+def test_remove_missing_sku_raises():
+    s = Store()
+    with pytest.raises(ValueError):
+        s.remove("ghost", 1)
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_filters_and_sorts():
+    s = Store()
+    s.add("apple", 3)
+    s.add("pear", 1)
+    s.add("mango", 1)
+    s.add("banana", 5)
+    # below 5: mango(1), pear(1), apple(3); banana(5) excluded
+    # ties on quantity 1 break by sku: mango before pear
+    assert s.low_stock(5) == ["mango", "pear", "apple"]
+
+
+def test_low_stock_excludes_equal_to_threshold():
+    s = Store()
+    s.add("apple", 5)
+    s.add("pear", 4)
+    assert s.low_stock(5) == ["pear"]
+
+
+def test_low_stock_empty_store():
+    s = Store()
+    assert s.low_stock(5) == []
