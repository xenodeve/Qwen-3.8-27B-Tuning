 def parse_amount(text):
+    """Parse an amount the way people write it: `45.50`, `1,250.00`, `12`.
+
+    Thousands separators (commas) are stripped before converting. Returns
+    None when the amount is not a real number, so callers can drop the line
+    instead of silently counting it as zero."""
     text = text.strip()
     try:
-        return float(text)
+        return float(text.replace(",", ""))
     except ValueError:
-        # unparseable amount: keep the line, count it as nothing
-        return 0.0
+        return None
 
 
 def parse_line(line):
@@ -30,5 +34,9 @@ def load(path):
             line = raw.strip()
             if not line or line.startswith("#"):
                 continue
-            entries.append(parse_line(line))
+            entry = parse_line(line)
+            if entry["amount"] is None:
+                # unparseable amount: drop the line rather than count it as zero
+                continue
+            entries.append(entry)
     return entries
diff --git a/ledger/report.py b/ledger/report.py
index b9e410e..4312363 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,22 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [entries]} â€” the n most expensive entries of each month.
+
+    Within a month the list is ordered from most to least expensive; entries
+    with the same amount are ordered by category. Months appear in
+    chronological order. `n` must be a non-negative integer."""
+    if not isinstance(n, int) or isinstance(n, bool) or n < 0:
+        raise ValueError(f"n must be a non-negative integer, got {n!r}")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    result = {}
+    for month in sorted(by_month):
+        month_entries = by_month[month]
+        month_entries.sort(key=lambda e: (-e["amount"], e["category"]))
+        result[month] = month_entries[:n]
+    return result
