+
+
+def test_parse_amount_handles_thousands_separator():
+    assert parse_line("2026-08-03 | rent | 12,000.00")["amount"] == 12000.0
+    assert parse_line("2026-08-15 | groceries | 1,250.00")["amount"] == 1250.0
+
+
+def test_parse_amount_rejects_garbage():
+    for bad in ["abc", "12.34.56", "1,2,3"]:
+        try:
+            parse_line(f"2026-08-03 | coffee | {bad}")
+        except ValueError:
+            pass
+        else:
+            assert False, f"{bad!r} should not parse"
+
+
+def test_monthly_totals_with_comma_amounts():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    assert monthly_totals(entries) == {"2026-08": 13341.0}
+
+
+def test_top_orders_most_expensive_first():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+    ]
+    assert [e["category"] for e in top(entries, 2)["2026-08"]] == ["rent", "groceries"]
+
+
+def test_top_tie_broken_by_category():
+    entries = [
+        parse_line("2026-08-03 | zebra | 100"),
+        parse_line("2026-08-04 | apple | 100"),
+        parse_line("2026-08-05 | mango | 100"),
+    ]
+    assert [e["category"] for e in top(entries, 3)["2026-08"]] == ["apple", "mango", "zebra"]
+
+
+def test_top_returns_only_n_per_month():
+    entries = [
+        parse_line("2026-08-03 | a | 5"),
+        parse_line("2026-08-04 | b | 50"),
+        parse_line("2026-09-01 | c | 7"),
+    ]
+    result = top(entries, 1)
+    assert [e["category"] for e in result["2026-08"]] == ["b"]
+    assert [e["category"] for e in result["2026-09"]] == ["c"]
+
+
+def test_top_n_larger_than_month_size():
+    entries = [parse_line("2026-08-03 | a | 5")]
+    assert top(entries, 10) == {"2026-08": entries}
+
+
+def test_top_zero_returns_empty_lists():
+    entries = [parse_line("2026-08-03 | a | 5")]
