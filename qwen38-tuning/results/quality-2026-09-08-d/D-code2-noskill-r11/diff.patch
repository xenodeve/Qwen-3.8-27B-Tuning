diff --git a/ledger/report.py b/ledger/report.py
index b9e410e..103f4e7 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,19 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [the n most expensive entries of that month]}.
+
+    Each month's list is sorted most expensive first; ties are broken by
+    category (alphabetically). Months with fewer than n entries get all of
+    them. n <= 0 yields an empty list for every month.
+    """
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(group, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, group in sorted(by_month.items())
+    }
