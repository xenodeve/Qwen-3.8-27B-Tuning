+
+
+def top(entries, n):
+    """{'YYYY-MM': entries} â€” the n most expensive entries per month.
+
+    Ordered most expensive first; equal amounts ordered by category."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(items, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, items in sorted(by_month.items())
+    }
