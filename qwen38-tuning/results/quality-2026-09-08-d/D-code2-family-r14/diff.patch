 def test_parse_line_basic():
@@ -23,3 +24,70 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_amount_comma_thousands():
+    assert parse_amount("12,000.00") == 12000.0
+    assert parse_amount("1,250.00") == 1250.0
+
+
+def test_parse_amount_unparseable_raises():
+    for bad in ("abc", "12.34.56", ""):
+        try:
+            parse_amount(bad)
+        except ValueError:
+            continue
+        assert False, f"parse_amount({bad!r}) should raise ValueError"
+
+
+def test_parse_amount_negative_and_plain():
+    assert parse_amount("-50.00") == -50.0
+    assert parse_amount("12") == 12.0
+    assert parse_amount("-1,250.00") == -1250.0
+
+
+def test_monthly_totals_comma_amounts():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    assert monthly_totals(entries) == {"2026-08": 13341.00}
+
+
+def test_top_groups_by_month_and_orders_expensive_first():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+    ]
+    result = top(entries, 2)
+    assert set(result) == {"2026-08", "2026-09"}
+    assert [e["category"] for e in result["2026-08"]] == ["rent", "groceries"]
+    assert [e["category"] for e in result["2026-09"]] == ["rent"]
+
+
+def test_top_tie_break_by_category():
+    entries = [
+        parse_line("2026-08-03 | zeta | 100.00"),
+        parse_line("2026-08-04 | alpha | 100.00"),
+        parse_line("2026-08-05 | mid | 100.00"),
+    ]
+    result = top(entries, 3)
+    assert [e["category"] for e in result["2026-08"]] == ["alpha", "mid", "zeta"]
+
+
+def test_top_limits_to_n():
+    entries = [
+        parse_line("2026-08-03 | a | 10.00"),
+        parse_line("2026-08-04 | b | 20.00"),
+        parse_line("2026-08-05 | c | 30.00"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["c", "b"]
+
+
+def test_top_empty():
+    assert top([], 5) == {}
