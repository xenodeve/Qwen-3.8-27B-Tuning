@@ -8,3 +8,17 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [top n entries of that month]}.
+
+    Each list is sorted most expensive first; entries with equal amounts are
+    ordered by category. Months with fewer than n entries get all of them."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(group, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, group in sorted(by_month.items())
+    }
