+def test_parse_line_handles_thousands_separators():
+    e = parse_line("2026-08-03 | rent | 12,000.00")
+    assert e["amount"] == 12000.0
+
+
+def test_parse_line_rejects_unparseable_amount():
+    try:
+        parse_line("2026-08-03 | coffee | abt")
+    except ValueError:
+        return
+    assert False
+
+
+def test_sample_file_august_total():
+    # regression: comma amounts used to be counted as 0.0, giving 91.00
+    assert monthly_totals(load("data/sample.txt"))["2026-08"] == 13341.00
+
+
+def test_top_sorts_by_amount_desc_then_category():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-04 | books | 45.50"),
+        parse_line("2026-08-05 | rent | 12,000.00"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+    ]
+    result = top(entries, 2)
