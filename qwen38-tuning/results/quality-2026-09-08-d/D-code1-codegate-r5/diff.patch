diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..45c612f 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,30 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity currently held; the
+        stored quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is strictly below threshold,
+        ordered by quantity ascending, then by sku ascending."""
+        return [
+            sku
+            for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+            if qty < threshold
+        ]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..c707a61 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,76 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_insufficient_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove did not raise for insufficient quantity"
+    assert s.quantity("apple") == 3
+    assert s.total() == 3
+
+
+def test_remove_insufficient_unknown_sku_raises_and_keeps_quantity():
+    s = Store()
+    try:
+        s.remove("banana", 1)
+    except ValueError as e:
+        assert "banana" in str(e)
+        assert "0" in str(e)
+    else:
+        assert False, "remove did not raise for unknown sku"
+    assert s.quantity("banana") == 0
+    assert s.skus() == []
+
+
+def test_remove_exact_and_partial():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 1) == 2
+    assert s.quantity("apple") == 2
+    assert s.remove("apple", 2) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        try:
+            s.remove("apple", bad)
+        except ValueError:
+            continue
+        assert False, f"remove accepted {bad!r}"
+    assert s.quantity("apple") == 3
+
+
+def test_low_stock_strictly_below_sorted_by_qty_then_sku():
+    s = Store()
+    s.add("apple", 1)
+    s.add("banana", 2)
+    s.add("cherry", 2)
+    s.add("date", 5)
+    assert s.low_stock(3) == ["apple", "banana", "cherry"]
+
+
+def test_low_stock_empty_and_all():
+    s = Store()
+    assert s.low_stock(5) == []
+    s.add("apple", 1)
+    s.add("banana", 2)
+    assert s.low_stock(100) == ["apple", "banana"]
+
+
+def test_low_stock_excludes_equal_to_threshold():
+    s = Store()
+    s.add("apple", 3)
+    s.add("banana", 2)
+    assert s.low_stock(3) == ["banana"]
