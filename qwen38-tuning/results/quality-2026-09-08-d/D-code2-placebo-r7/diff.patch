--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,15 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [entry, ...]} â€” the n most expensive entries of each month,
+    sorted by amount descending, ties broken by category ascending."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(months, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, months in sorted(by_month.items())
+    }
