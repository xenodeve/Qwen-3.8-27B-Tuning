 def test_parse_line_basic():
@@ -23,3 +23,69 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_line_amount_with_thousands_separator():
+    e = parse_line("2026-08-03 | rent | 12,000.00")
+    assert e["amount"] == 12000.0
+
+
+def test_parse_line_amount_with_multiple_separators():
+    e = parse_line("2026-08-15 | groceries | 1,250.00")
+    assert e["amount"] == 1250.0
+
+
+def test_parse_line_rejects_unparseable_amount():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_parse_line_rejects_empty_amount():
+    try:
+        parse_line("2026-08-03 | coffee | ")
+    except ValueError:
+        return
+    assert False
+
+
+def test_monthly_totals_sample_august():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+    ]
+    assert monthly_totals(entries) == {"2026-08": 13341.0}
+
+
+def test_top_returns_n_most_expensive_per_month():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+        parse_line("2026-09-02 | books | 890"),
+    ]
+    result = top(entries, 2)
+    assert result == {
+        "2026-08": [
+            {"date": "2026-08-03", "category": "rent", "amount": 12000.0},
+            {"date": "2026-08-15", "category": "groceries", "amount": 1250.0},
+        ],
+        "2026-09": [
+            {"date": "2026-09-02", "category": "books", "amount": 890.0},
+        ],
+    }
+
+
+def test_top_ties_broken_by_category():
+    entries = [
+        parse_line("2026-08-03 | zebra | 100"),
+        parse_line("2026-08-04 | apple | 100"),
+        parse_line("2026-08-05 | mango | 100"),
+    ]
+    result = top(entries, 2)
+    assert [e["category"] for e in result["2026-08"]] == ["apple", "mango"]
