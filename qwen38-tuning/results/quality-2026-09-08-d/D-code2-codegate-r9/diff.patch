diff --git a/ledger/report.py b/ledger/report.py
index b9e410e..19624cd 100644
--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,20 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [up to n entries]} â€” the n most expensive entries of each month,
+    sorted most expensive first; ties broken by category (ascending). n must be a
+    non-negative int."""
+    if not isinstance(n, int) or isinstance(n, bool):
+        raise TypeError("n must be an integer")
+    if n < 0:
+        raise ValueError("n must be a non-negative integer")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(month_entries, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, month_entries in sorted(by_month.items())
+    }
