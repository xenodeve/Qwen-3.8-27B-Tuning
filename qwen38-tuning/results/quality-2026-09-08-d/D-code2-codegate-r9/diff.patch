+
+from ledger import parse_line, load, monthly_totals, top
+
+SAMPLE = Path(__file__).resolve().parent.parent / "data" / "sample.txt"
 
 
 def test_parse_line_basic():
@@ -23,3 +27,88 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_line_reads_comma_thousands():
+    e = parse_line("2026-08-03 | rent | 12,000.00")
+    assert e == {"date": "2026-08-03", "category": "rent", "amount": 12000.0}
+
+
+def test_parse_line_unparseable_amount_raises():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False, "unparseable amount must raise, not count as zero"
+
+
+def test_parse_line_empty_amount_raises():
+    try:
+        parse_line("2026-08-03 | coffee |")
+    except ValueError:
+        return
+    assert False, "empty amount must raise, not count as zero"
+
+
+def test_monthly_totals_sample_file():
+    assert monthly_totals(load(SAMPLE)) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_top_returns_top_n_per_month():
+    entries = [
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-08-20 | coffee | 45.50"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+    ]
+    assert top(entries, 2) == {
+        "2026-08": [
+            {"date": "2026-08-03", "category": "rent", "amount": 12000.0},
+            {"date": "2026-08-15", "category": "groceries", "amount": 1250.0},
+        ],
+        "2026-09": [{"date": "2026-09-01", "category": "rent", "amount": 12000.0}],
+    }
+
+
+def test_top_tie_breaks_by_category():
+    entries = [
+        parse_line("2026-08-03 | zebra | 100"),
+        parse_line("2026-08-04 | apple | 100"),
+        parse_line("2026-08-05 | mango | 100"),
+    ]
+    assert [e["category"] for e in top(entries, 3)["2026-08"]] == ["apple", "mango", "zebra"]
+
+
+def test_top_n_zero_returns_empty_lists():
+    entries = [parse_line("2026-08-03 | coffee | 45.50")]
+    assert top(entries, 0) == {"2026-08": []}
+
+
+def test_top_negative_n_raises():
+    entries = [parse_line("2026-08-03 | coffee | 45.50")]
+    try:
+        top(entries, -1)
+    except ValueError:
+        return
+    assert False, "negative n must raise"
+
+
+def test_top_non_int_n_raises():
+    entries = [parse_line("2026-08-03 | coffee | 45.50")]
+    try:
+        top(entries, "2")
+    except TypeError:
+        return
+    assert False, "non-int n must raise"
+
+
+def test_top_empty_entries():
+    assert top([], 3) == {}
+
+
+def test_load_missing_file_raises(tmp_path):
