diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..b425c84 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,30 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity in stock; the store is
+        left unchanged when it does.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold, fewest first.
+
+        Ties on quantity are ordered by sku.
+        """
+        low = [(qty, sku) for sku, qty in self._items.items() if qty < threshold]
+        low.sort()
+        return [sku for qty, sku in low]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..09b82fc 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,72 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_rejects_overdraw():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 4)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "3" in msg
+    else:
+        assert False, "remove accepted more than in stock"
+    # state unchanged after the raise
+    assert s.quantity("apple") == 3
+    assert s.total() == 3
+
+
+def test_remove_rejects_unknown_sku():
+    s = Store()
+    s.add("pear", 2)
+    try:
+        s.remove("apple", 1)
+    except ValueError as e:
+        assert "apple" in str(e)
+    else:
+        assert False, "remove accepted an unknown sku"
+    assert s.quantity("pear") == 2
+
+
+def test_remove_exact_amount_ok():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_low_stock_orders_by_qty_then_sku():
+    s = Store()
+    s.add("banana", 1)
+    s.add("apple", 1)
+    s.add("date", 2)
+    s.add("cherry", 3)
+    assert s.low_stock(4) == ["apple", "banana", "date", "cherry"]
+
+
+def test_low_stock_includes_out_of_stock():
+    s = Store()
+    s.add("cherry", 1)
+    s.remove("cherry", 1)  # leaves qty 0
+    s.add("apple", 2)
+    assert s.low_stock(5) == ["cherry", "apple"]
+
+
+def test_low_stock_excludes_equal_to_threshold():
+    s = Store()
+    s.add("apple", 2)
+    s.add("pear", 1)
+    assert s.low_stock(2) == ["pear"]
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(5) == []
+
+
+def test_low_stock_none_below_threshold():
+    s = Store()
+    s.add("apple", 5)
+    assert s.low_stock(5) == []
