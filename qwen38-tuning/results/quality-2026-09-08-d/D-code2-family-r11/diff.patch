+from ledger import parse_line, load, monthly_totals, top
 
 
 def test_parse_line_basic():
@@ -23,3 +23,58 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_line_comma_amount():
+    e = parse_line("2026-08-03 | rent | 12,000.00")
+    assert e == {"date": "2026-08-03", "category": "rent", "amount": 12000.0}
+
+
+def test_parse_line_unparseable_amount_raises():
+    try:
+        parse_line("2026-08-03 | coffee | N/A")
+    except ValueError:
+        return
+    assert False
+
+
+def test_sample_totals():
+    entries = load("data/sample.txt")
+    assert monthly_totals(entries) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_load_missing_file_raises(tmp_path):
+    try:
+        load(tmp_path / "nope.txt")
+    except FileNotFoundError:
+        return
+    assert False
+
+
+def test_top_returns_most_expensive_per_month():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-09-02 | books | 890"),
+    ]
+    assert top(entries, 2) == {
+        "2026-08": [
+            {"date": "2026-08-03", "category": "rent", "amount": 12000.0},
+            {"date": "2026-08-15", "category": "groceries", "amount": 1250.0},
+        ],
+        "2026-09": [{"date": "2026-09-02", "category": "books", "amount": 890.0}],
+    }
+
+
+def test_top_ties_broken_by_category():
+    entries = [
+        parse_line("2026-08-03 | zeta | 100"),
+        parse_line("2026-08-04 | alpha | 100"),
+    ]
+    assert [e["category"] for e in top(entries, 2)["2026-08"]] == ["alpha", "zeta"]
+
+
+def test_top_n_zero_and_empty():
+    assert top([], 3) == {}
+    assert top([parse_line("2026-08-03 | coffee | 45.50")], 0) == {"2026-08": []}
