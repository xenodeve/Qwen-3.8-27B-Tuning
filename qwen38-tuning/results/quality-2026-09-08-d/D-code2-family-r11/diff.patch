     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': the n most expensive entries of that month}, most expensive
+    first; equal amounts ordered by category."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    limit = n if n > 0 else 0
+    return {
+        month: sorted(months, key=lambda e: (-e["amount"], e["category"]))[:limit]
+        for month, months in sorted(by_month.items())
+    }
