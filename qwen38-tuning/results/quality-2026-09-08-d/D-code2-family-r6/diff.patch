 def test_parse_line_basic():
@@ -23,3 +25,53 @@ def test_load_skips_comments_and_blanks(tmp_path):
 def test_monthly_totals_groups_by_month():
     entries = [parse_line("2026-08-03 | coffee | 45.50"), parse_line("2026-09-02 | books | 890")]
     assert monthly_totals(entries) == {"2026-08": 45.5, "2026-09": 890.0}
+
+
+def test_parse_amount_handles_thousands_separator():
+    assert parse_line("2026-08-03 | rent | 12,000.00")["amount"] == 12000.0
+    assert parse_line("2026-08-15 | groceries | 1,250.00")["amount"] == 1250.0
+
+
+def test_parse_amount_rejects_unparseable():
+    # An amount that can't be read is a real error, not a silent zero.
+    with pytest.raises(ValueError):
+        parse_line("2026-08-03 | coffee | abc")
+
+
+def test_sample_totals(tmp_path):
+    p = tmp_path / "sample.txt"
+    p.write_text(
+        "# date | category | amount\n"
+        "2026-08-03 | coffee | 45.50\n"
+        "2026-08-03 | rent | 12,000.00\n"
+        "2026-08-15 | groceries | 1,250.00\n"
+        "2026-08-20 | coffee | 45.50\n"
+        "2026-09-01 | rent | 12,000.00\n"
+        "2026-09-02 | books | 890\n",
+        encoding="utf-8",
+    )
+    assert monthly_totals(load(p)) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_top_returns_n_most_expensive_per_month():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+        parse_line("2026-09-02 | books | 890"),
+    ]
+    result = top(entries, 2)
+    assert result["2026-08"] == [
+        {"date": "2026-08-03", "category": "rent", "amount": 12000.0},
+        {"date": "2026-08-15", "category": "groceries", "amount": 1250.0},
+    ]
+    assert result["2026-09"] == [{"date": "2026-09-02", "category": "books", "amount": 890.0}]
+
+
+def test_top_ties_broken_by_category():
+    entries = [
+        parse_line("2026-08-01 | zeta | 100"),
+        parse_line("2026-08-02 | alpha | 100"),
+        parse_line("2026-08-03 | mid | 100"),
+    ]
+    assert [e["category"] for e in top(entries, 3)["2026-08"]] == ["alpha", "mid", "zeta"]
