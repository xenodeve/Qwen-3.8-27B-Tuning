--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,17 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [entries]} with up to n entries per month, most expensive
+    first; ties broken by category (alphabetical). n must be a non-negative int."""
+    if not isinstance(n, int) or isinstance(n, bool) or n < 0:
+        raise ValueError(f"n must be a non-negative int, got {n!r}")
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(months, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, months in sorted(by_month.items())
+    }
