diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..546bc95 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,29 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds what is in stock; the stored
+        quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold, fewest first.
+
+        Ties on quantity are ordered by sku.
+        """
+        low = sorted((qty, sku) for sku, qty in self._items.items() if qty < threshold)
+        return [sku for qty, sku in low]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..150b1c5 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -27,3 +27,80 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_returns_remaining():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_more_than_in_stock_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 4)
+    try:
+        s.remove("apple", 5)
+    except ValueError as e:
+        msg = str(e)
+        assert "apple" in msg
+        assert "4" in msg
+    else:
+        assert False, "remove did not raise for over-removal"
+    assert s.quantity("apple") == 4
+
+
+def test_remove_more_than_in_stock_for_missing_sku():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError as e:
+        assert "ghost" in str(e)
+    else:
+        assert False, "remove did not raise for missing sku"
+    assert s.quantity("ghost") == 0
+
+
+def test_remove_exact_amount_is_allowed():
+    s = Store()
+    s.add("pear", 3)
+    assert s.remove("pear", 3) == 0
+    assert s.quantity("pear") == 0
+
+
+def test_low_stock_filters_below_threshold():
+    s = Store()
+    s.add("a", 1)
+    s.add("b", 5)
+    assert s.low_stock(5) == ["a"]
+
+
+def test_low_stock_excludes_equal_to_threshold():
+    s = Store()
+    s.add("a", 5)
+    s.add("b", 4)
+    assert s.low_stock(5) == ["b"]
+
+
+def test_low_stock_orders_by_quantity_then_sku():
+    s = Store()
+    s.add("zeta", 2)
+    s.add("alpha", 2)
+    s.add("mid", 1)
+    s.add("high", 9)
+    assert s.low_stock(5) == ["mid", "alpha", "zeta"]
+
+
+def test_low_stock_empty_when_all_at_or_above_threshold():
+    s = Store()
+    s.add("a", 10)
+    s.add("b", 10)
+    assert s.low_stock(10) == []
+
+
+def test_low_stock_includes_zero_quantity_sku():
+    s = Store()
+    s.add("a", 1)
+    s.add("b", 3)
+    s.remove("a", 1)  # a drops to 0
+    assert s.low_stock(5) == ["a", "b"]
