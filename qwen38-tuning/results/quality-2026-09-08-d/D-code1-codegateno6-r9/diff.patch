diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..0109b28 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,16 +16,31 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty would take the quantity below zero.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} in stock"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
+    def low_stock(self, threshold):
+        """SKUs with quantity strictly below threshold, fewest first (ties by sku)."""
+        return [
+            sku
+            for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+            if qty < threshold
+        ]
+
     def total(self):
         return sum(self._items.values())
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..de20b3e 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -1,3 +1,5 @@
+import pytest
+
 from inventory import Store
 
 
@@ -27,3 +29,67 @@ def test_save_and_load_roundtrip(tmp_path):
     s.save(p)
     t = Store().load(p)
     assert t.quantity("apple") == 3 and t.skus() == ["apple"]
+
+
+def test_remove_rejects_bad_qty():
+    s = Store()
+    s.add("apple", 3)
+    for bad in (0, -1, 1.5, "2"):
+        with pytest.raises(ValueError):
+            s.remove("apple", bad)
+    assert s.quantity("apple") == 3
+
+
+def test_remove_overdraw_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    with pytest.raises(ValueError) as excinfo:
+        s.remove("apple", 5)
+    msg = str(excinfo.value)
+    assert "apple" in msg
+    assert "3" in msg
+    assert s.quantity("apple") == 3
+    assert s.total() == 3
+
+
+def test_remove_unknown_sku_raises():
+    s = Store()
+    with pytest.raises(ValueError) as excinfo:
+        s.remove("ghost", 1)
+    assert "ghost" in str(excinfo.value)
+    assert s.quantity("ghost") == 0
+
+
+def test_remove_exact_quantity_ok():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_low_stock_filters_and_orders():
+    s = Store()
+    s.add("b", 2)
+    s.add("a", 5)
+    s.add("c", 1)
+    s.add("d", 4)
+    assert s.low_stock(3) == ["c", "b"]
+
+
+def test_low_stock_tie_breaks_by_sku():
+    s = Store()
+    s.add("z", 1)
+    s.add("m", 1)
+    s.add("a", 1)
+    assert s.low_stock(2) == ["a", "m", "z"]
+
+
+def test_low_stock_is_strictly_less_than():
+    s = Store()
+    s.add("a", 2)
+    s.add("b", 3)
+    assert s.low_stock(3) == ["a"]
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(5) == []
