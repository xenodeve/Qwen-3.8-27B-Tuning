+
+
+def test_parse_amount_handles_thousands_separator():
+    assert parse_line("2026-08-03 | rent | 12,000.00")["amount"] == 12000.0
+    assert parse_line("2026-08-15 | groceries | 1,250.00")["amount"] == 1250.0
+
+
+def test_unparseable_amount_raises_not_zero():
+    try:
+        parse_line("2026-08-03 | coffee | abc")
+    except ValueError:
+        return
+    assert False
+
+
+def test_sample_file_monthly_totals():
+    assert monthly_totals(load("data/sample.txt")) == {"2026-08": 13341.0, "2026-09": 12890.0}
+
+
+def test_top_orders_by_amount_desc_then_category():
+    entries = [
+        parse_line("2026-08-03 | coffee | 45.50"),
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-08-15 | groceries | 1,250.00"),
+    ]
+    assert [e["category"] for e in top(entries, 2)["2026-08"]] == ["rent", "groceries"]
+
+
+def test_top_tie_broken_by_category():
+    entries = [
+        parse_line("2026-08-03 | zeta | 100"),
+        parse_line("2026-08-04 | alpha | 100"),
+    ]
+    assert [e["category"] for e in top(entries, 2)["2026-08"]] == ["alpha", "zeta"]
+
+
+def test_top_returns_n_per_month():
+    entries = [
+        parse_line("2026-08-03 | rent | 12,000.00"),
+        parse_line("2026-09-01 | rent | 12,000.00"),
+        parse_line("2026-09-02 | books | 890"),
+    ]
+    result = top(entries, 1)
+    assert [e["category"] for e in result["2026-08"]] == ["rent"]
+    assert [e["category"] for e in result["2026-09"]] == ["rent"]
