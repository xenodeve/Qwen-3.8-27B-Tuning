--- a/ledger/report.py
+++ b/ledger/report.py
@@ -8,3 +8,17 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [the n most expensive entries of that month]}.
+
+    Each list is ordered from most to least expensive; ties are broken by
+    category (ascending). Months with fewer than n entries list all of them."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(months, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, months in sorted(by_month.items())
+    }
