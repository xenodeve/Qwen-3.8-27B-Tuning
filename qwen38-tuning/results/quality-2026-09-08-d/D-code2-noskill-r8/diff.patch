@@ -8,3 +8,17 @@ def monthly_totals(entries):
     for e in entries:
         totals[e["date"][:7]] += e["amount"]
     return dict(sorted(totals.items()))
+
+
+def top(entries, n):
+    """{'YYYY-MM': [entries]} â€” the n most expensive entries per month.
+
+    Each month's list is ordered most expensive first; ties are broken by
+    category (ascending). Months with fewer than n entries list them all."""
+    by_month = defaultdict(list)
+    for e in entries:
+        by_month[e["date"][:7]].append(e)
+    return {
+        month: sorted(month_entries, key=lambda e: (-e["amount"], e["category"]))[:n]
+        for month, month_entries in sorted(by_month.items())
+    }
