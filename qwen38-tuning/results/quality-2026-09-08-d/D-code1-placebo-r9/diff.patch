diff --git a/inventory/store.py b/inventory/store.py
index 9fc6ddc..27d9a74 100644
--- a/inventory/store.py
+++ b/inventory/store.py
@@ -16,13 +16,32 @@ class Store:
         return self._items[sku]
 
     def remove(self, sku, qty):
-        """Remove qty units of sku and return the remaining quantity."""
+        """Remove qty units of sku and return the remaining quantity.
+
+        Raises ValueError if qty exceeds the quantity on hand; the stored
+        quantity is left unchanged in that case.
+        """
         if not isinstance(qty, int) or qty <= 0:
             raise ValueError(f"qty must be a positive integer, got {qty!r}")
         current = self._items.get(sku, 0)
+        if qty > current:
+            raise ValueError(
+                f"cannot remove {qty} of {sku!r}: only {current} on hand"
+            )
         self._items[sku] = current - qty
         return self._items[sku]
 
+    def low_stock(self, threshold):
+        """Return skus whose quantity is below threshold, fewest first.
+
+        Ties on quantity are broken by sku.
+        """
+        return [
+            sku
+            for sku, qty in sorted(self._items.items(), key=lambda kv: (kv[1], kv[0]))
+            if qty < threshold
+        ]
+
     def quantity(self, sku):
         return self._items.get(sku, 0)
 
diff --git a/tests/test_store.py b/tests/test_store.py
index fb40e14..3f497a3 100644
--- a/tests/test_store.py
+++ b/tests/test_store.py
@@ -20,6 +20,68 @@ def test_add_rejects_bad_qty():
         assert False, f"add accepted {bad!r}"
 
 
+def test_remove_happy_path():
+    s = Store()
+    s.add("apple", 5)
+    assert s.remove("apple", 2) == 3
+    assert s.quantity("apple") == 3
+
+
+def test_remove_more_than_on_hand_raises_and_keeps_quantity():
+    s = Store()
+    s.add("apple", 3)
+    try:
+        s.remove("apple", 5)
+    except ValueError as exc:
+        msg = str(exc)
+        assert "apple" in msg
+        assert "3" in msg  # the quantity left on hand
+    else:
+        assert False, "remove did not raise"
+    assert s.quantity("apple") == 3
+
+
+def test_remove_unknown_sku_raises_and_stays_empty():
+    s = Store()
+    try:
+        s.remove("ghost", 1)
+    except ValueError as exc:
+        assert "ghost" in str(exc)
+    else:
+        assert False, "remove did not raise"
+    assert s.quantity("ghost") == 0
+
+
+def test_remove_exactly_on_hand_is_allowed():
+    s = Store()
+    s.add("apple", 3)
+    assert s.remove("apple", 3) == 0
+    assert s.quantity("apple") == 0
+
+
+def test_low_stock_filters_below_threshold():
+    s = Store()
+    s.add("apple", 1)
+    s.add("pear", 4)
+    s.add("plum", 2)
+    assert s.low_stock(3) == ["apple", "plum"]
+    assert s.low_stock(5) == ["apple", "plum", "pear"]
+    assert s.low_stock(1) == []
+
+
+def test_low_stock_orders_by_quantity_then_sku():
+    s = Store()
+    s.add("pear", 1)
+    s.add("apple", 1)
+    s.add("plum", 2)
+    s.add("cherry", 2)
+    assert s.low_stock(3) == ["apple", "pear", "cherry", "plum"]
+
+
+def test_low_stock_empty_store():
+    assert Store().low_stock(10) == []
+
+
