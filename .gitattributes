# The docs are written on Windows and read by agents on any platform.
# Normalise in the repo, leave the working copy alone.
* text=auto
*.sh  text eol=lf
*.py  text eol=lf
qwen38-tuning/bench/corpora/real-code.txt text eol=lf
*.ps1 text eol=crlf
*.gguf binary
*.jpg  binary
*.png  binary
# vendored files are pinned by sha256; keep their bytes exact on checkout
qwen38-tuning/third_party/** -text
