# Runtime scratch, not project content
ocworker/
# Log CONTENTS, not the log folder. Excluding the directory itself stops git
# descending into it, so a negation for a file inside can never re-include
# that file -- which is how qwen38-tuning/logs/README.md stayed out of the
# repo entirely, a README no clone has ever seen, in a project whose
# convention is that every folder has one.
**/logs/*
!**/logs/README.md
*.log

# Model artifacts and caches are gigabytes and live in the HF cache
*.gguf
__pycache__/
*.pyc
.pytest_cache/

# Code the model EMITS during a benchmark run. It is a measurement artifact,
# never something this project ships, and the developer's standing rule is that
# it gets deleted. `bench/_*` is the naming convention every runner uses:
# run_bench.py -> _work/, run_deep_bench.py -> _deepwork/.
#
# The glob, not a list. _work/ was ignored and _deepwork/ was not, so 157
# generated files sat committed until 2026-08-22. A list has to be remembered
# once per new runner; the glob does not.
# Pinned by bench/tests/test_no_committed_worker_output.py.
qwen38-tuning/bench/_*/

# Vendored llama.cpp build: half a gigabyte of CUDA DLLs, installed not authored
llama.cpp-cuda/
llama.cpp/
# PR #27342 build, staged beside 10472 so neither replaces the other (issue #17)
llama.cpp-dflash2/
# 1deefcca3 + the DFlash mirror patch, in a git worktree of llama.cpp/ so the
# unpatched tree and its binaries stay untouched (issue #52, task #47)
llama.cpp-mirror/
*.zip
*.dll
*.exe
*.lib
*.exp

# Runtime lock: names a live PID, meaningless in a checkout
qwen38-tuning/.port8080.lock
logs/llama-tap/
qwen38-tuning/logs/llama-tap/
logs/llama-slots/
qwen38-tuning/logs/llama-slots/

# Copied third-party source trees, built locally. The PATCH is tracked
# (qwen38-tuning/patches/) and the build script rebuilds the tree from
# %USERPROFILE%\.unsloth; the 418 MB of sources and ~2 GB of objects are not
# ours to carry.
/llama.cpp-unsloth-mirror/

# Scraped web pages, written by the firecrawl CLI during the 2026-09-01 research.
# 5 MB of third-party HTML-turned-markdown that nothing in the repo links to, and
# `check-doc-links.py` walks it and reports 22 broken links inside it. The
# research notes that cite these pages carry their URLs, so the scrape is a cache
# rather than a source. Delete it freely.
/.firecrawl/
